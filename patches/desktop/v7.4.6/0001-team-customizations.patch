+
+void ScanHistoryPage(std::shared_ptr<HistoryScan> state) {
+	const auto session = state->session;
+	const auto channel = state->channel;
+	session->api().request(MTPmessages_GetHistory(
+		channel->input(),
+		MTP_int(int(state->offsetId.bare)),
+		MTP_int(0), // offset_date
+		MTP_int(0), // add_offset
+		MTP_int(100),
+		MTP_int(0), // max_id
+		MTP_int(0), // min_id
+		MTP_long(0)
+	)).done([=](const MTPmessages_Messages &result) {
+		auto received = 0;
+		auto lowest = state->offsetId;
+		const auto apply = [&](const auto &data) {
+			session->data().processUsers(data.vusers());
+			session->data().processChats(data.vchats());
+			for (const auto &message : data.vmessages().v) {
+				const auto id = MsgId(message.match([](const auto &d) {
+					return d.vid().v;
+				}));
+				++received;
+				if (!lowest.bare || id < lowest) {
+					lowest = id;
+				}
+				message.match([&](const MTPDmessage &d) {
+					const auto from = d.vfrom_id();
+					if (!from) {
+						return;
+					}
+					const auto peer = peerFromMTP(*from);
+					if (!peerIsUser(peer)) {
+						return;
+					}
+					++state->messages;
+					auto &stats = state->authors[peerToUser(peer)];
+					const auto date = d.vdate().v;
+					++stats.count;
+					if (!stats.first || date < stats.first) {
+						stats.first = date;
+					}
+					if (date >= stats.last) {
+						stats.last = date;
+						stats.lastId = id;
+						stats.lastText = qs(d.vmessage());
+					}
+					// Реакции, опрос и упоминания по имени — следы молчащих.
+					if (const auto r = d.vreactions()) {
+						r->match([&](const MTPDmessageReactions &data) {
+							if (!data.vresults().v.isEmpty()) {
+								state->reactMsgs.push_back(id);
+							}
+						});
+					}
+					if (const auto media = d.vmedia()) {
+						if (media->type() == mtpc_messageMediaPoll) {
+							state->pollMsgs.push_back(id);
+						}
+					}
+					if (const auto entities = d.ventities()) {
+						for (const auto &entity : entities->v) {
+							if (entity.type() == mtpc_messageEntityMentionName) {
+								state->mentioned.emplace(UserId(
+									entity.c_messageEntityMentionName()
+										.vuser_id().v));
+							}
+						}
+					}
+				}, [&](const MTPDmessageService &d) {
+					const auto date = d.vdate().v;
+					const auto join = [&](UserId user) {
+						auto &stats = state->authors[user];
+						if (date >= stats.joined) {
+							stats.joined = date;
+							stats.joinId = id;
+						}
+					};
+					const auto from = d.vfrom_id()
+						? peerFromMTP(*d.vfrom_id())
+						: PeerId();
+					d.vaction().match([&](const MTPDmessageActionChatJoinedByLink &) {
+						if (peerIsUser(from)) {
+							join(peerToUser(from));
+						}
+					}, [&](const MTPDmessageActionChatJoinedByRequest &) {
+						if (peerIsUser(from)) {
+							join(peerToUser(from));
+						}
+					}, [&](const MTPDmessageActionChatAddUser &a) {
+						for (const auto &user : a.vusers().v) {
+							join(UserId(user.v));
+						}
+					}, [&](const MTPDmessageActionChatDeleteUser &a) {
+						auto &stats = state->authors[UserId(a.vuser_id().v)];
+						stats.left = std::max(stats.left, date);
+					}, [](const auto &) {
+					});
+				}, [](const auto &) {
+				});
+			}
+		};
+		result.match([&](const MTPDmessages_messagesNotModified &) {
+		}, [&](const auto &data) {
+			apply(data);
+		});
+		if (!received || lowest == state->offsetId || lowest.bare <= 1) {
+			base::take(state->done)(state);
+			return;
+		}
+		state->offsetId = lowest;
+		base::call_delayed(kMembersPagePause, session.get(), [=] {
+			ScanHistoryPage(state);
+		});
+	}).fail([=](const MTP::Error &error) {
+		if (const auto seconds = FloodWaitSeconds(error)) {
+			base::call_delayed(crl::time(seconds + 1) * 1000, session.get(), [=] {
+				ScanHistoryPage(state);
+			});
+			return;
+		}
+		state->error = error.type();
+		base::take(state->done)(state);
+	}).send();
+}
+
+// Те, кого не видно в истории: кто ставил реакции, голосовал в опросах и
+// был упомянут по имени. По каждому сообщению с реакцией и по каждому опросу
+// сервер отдаёт список людей с ключом доступа, поэтому им можно написать.
+struct Engagement {
+	not_null<Main::Session*> session;
+	not_null<ChannelData*> channel;
+	std::vector<MsgId> reactMsgs;
+	std::vector<MsgId> pollMsgs;
+	base::flat_set<UserId> mentioned;
+	// id → откуда узнали ("реакция", "опрос", "упоминание").
+	base::flat_map<UserId, QString> found;
+	int reactIndex = 0;
+	int pollIndex = 0;
+	QString offset;
+	int done = 0;
+	int total = 0;
+	Fn<void(std::shared_ptr<Engagement>)> finished;
+};
+
+void CollectReactionsThenPolls(std::shared_ptr<Engagement> state);
+
+void NextEngagementStep(std::shared_ptr<Engagement> state) {
+	base::call_delayed(kMembersPagePause, state->session.get(), [=] {
+		CollectReactionsThenPolls(state);
+	});
+}
+
+void HandleEngagementFlood(
+		std::shared_ptr<Engagement> state,
+		const MTP::Error &error) {
+	if (const auto seconds = FloodWaitSeconds(error)) {
+		base::call_delayed(
+			crl::time(seconds + 1) * 1000,
+			state->session.get(),
+			[=] { CollectReactionsThenPolls(state); });
+	} else {
+		// Одно сообщение не отдалось — не беда, идём к следующему.
+		state->offset = QString();
+		if (state->reactIndex < int(state->reactMsgs.size())) {
+			++state->reactIndex;
+		} else {
+			++state->pollIndex;
+		}
+		NextEngagementStep(state);
+	}
+}
+
+void CollectReactionsThenPolls(std::shared_ptr<Engagement> state) {
+	const auto session = state->session;
+	const auto channel = state->channel;
+	const auto note = [=](const MTPVector<MTPUser> &users, auto &&peerOf, const QString &label) {
+		session->data().processUsers(users);
+		for (const auto &peerId : peerOf) {
+			if (peerIsUser(peerId)) {
+				state->found.emplace(peerToUser(peerId), label);
+			}
+		}
+	};
+	if (state->reactIndex < int(state->reactMsgs.size())) {
+		const auto msgId = state->reactMsgs[state->reactIndex];
+		using Flag = MTPmessages_GetMessageReactionsList::Flag;
+		session->api().request(MTPmessages_GetMessageReactionsList(
+			MTP_flags(state->offset.isEmpty()
+				? Flag(0)
+				: Flag::f_offset),
+			channel->input(),
+			MTP_int(msgId.bare),
+			MTPReaction(),
+			MTP_string(state->offset),
+			MTP_int(100)
+		)).done([=](const MTPmessages_MessageReactionsList &result) {
+			result.match([&](const MTPDmessages_messageReactionsList &data) {
+				auto peers = std::vector<PeerId>();
+				for (const auto &r : data.vreactions().v) {
+					r.match([&](const MTPDmessagePeerReaction &d) {
+						peers.push_back(peerFromMTP(d.vpeer_id()));
+					});
+				}
+				note(data.vusers(), peers, u"реакция"_q);
+				state->offset = data.vnext_offset().value_or_empty();
+			});
+			if (state->offset.isEmpty()) {
+				++state->reactIndex;
+			}
+			++state->done;
+			NextEngagementStep(state);
+		}).fail([=](const MTP::Error &error) {
+			HandleEngagementFlood(state, error);
+		}).send();
+		return;
+	}
+	if (state->pollIndex < int(state->pollMsgs.size())) {
+		const auto msgId = state->pollMsgs[state->pollIndex];
+		using Flag = MTPmessages_GetPollVotes::Flag;
+		session->api().request(MTPmessages_GetPollVotes(
+			MTP_flags(state->offset.isEmpty()
+				? Flag(0)
+				: Flag::f_offset),
+			channel->input(),
+			MTP_int(msgId.bare),
+			MTPbytes(),
+			MTP_string(state->offset),
+			MTP_int(100)
+		)).done([=](const MTPmessages_VotesList &result) {
+			result.match([&](const MTPDmessages_votesList &data) {
+				auto peers = std::vector<PeerId>();
+				for (const auto &v : data.vvotes().v) {
+					v.match([&](const auto &d) {
+						peers.push_back(peerFromMTP(d.vpeer()));
+					});
+				}
+				note(data.vusers(), peers, u"опрос"_q);
+				state->offset = data.vnext_offset().value_or_empty();
+			});
+			if (state->offset.isEmpty()) {
+				++state->pollIndex;
+			}
+			++state->done;
+			NextEngagementStep(state);
+		}).fail([=](const MTP::Error &error) {
+			HandleEngagementFlood(state, error);
+		}).send();
+		return;
+	}
+	// Реакции и опросы собраны, упоминания известны сразу.
+	for (const auto id : state->mentioned) {
+		state->found.emplace(id, u"упоминание"_q);
+	}
+	base::take(state->finished)(state);
+}
+
+// Что класть в выгрузку. Настройки задаёт окно перед выгрузкой.
+struct ExportOptions {
+	bool includeAdmins = false;
+	bool reactions = true;
+	bool polls = true;
+	bool mentions = true;
+	bool onlyMessageable = false;
+};
+
+void CollectEngagement(
+		not_null<ChannelData*> channel,
+		const HistoryScan &history,
+		const ExportOptions &options,
+		Fn<void(std::shared_ptr<Engagement>)> finished) {
+	auto state = std::make_shared<Engagement>(Engagement{
+		.session = &channel->session(),
+		.channel = channel,
+		.reactMsgs = options.reactions ? history.reactMsgs : std::vector<MsgId>(),
+		.pollMsgs = options.polls ? history.pollMsgs : std::vector<MsgId>(),
+		.mentioned = options.mentions ? history.mentioned : base::flat_set<UserId>(),
+		.finished = std::move(finished),
+	});
+	state->total = int(state->reactMsgs.size() + state->pollMsgs.size());
+	CollectReactionsThenPolls(std::move(state));
+}
+
+[[nodiscard]] QString TsvField(QString text) {
+	text.replace(QChar('\t'), QChar(' '));
+	text.replace(QChar('\r'), QChar(' '));
+	text.replace(QChar('\n'), u" / "_q);
+	return text.trimmed();
+}
+
+[[nodiscard]] QString TsvDate(TimeId date) {
+	return date
+		? QDateTime::fromSecsSinceEpoch(date).toString(u"dd.MM.yyyy HH:mm"_q)
+		: QString();
+}
+
+[[nodiscard]] QString LastseenText(not_null<UserData*> user) {
+	const auto status = user->lastseen();
+	if (user->isBot()) {
+		return u"бот"_q;
+	} else if (status.isOnline(base::unixtime::now())) {
+		return u"в сети"_q;
+	} else if (const auto till = status.onlineTill()) {
+		return TsvDate(till);
+	} else if (status.isRecently()) {
+		return u"недавно"_q;
+	} else if (status.isWithinWeek()) {
+		return u"на этой неделе"_q;
+	} else if (status.isWithinMonth()) {
+		return u"в этом месяце"_q;
+	} else if (status.isLongAgo()) {
+		return u"давно"_q;
+	}
+	return u"скрыто"_q;
+}
+
+[[nodiscard]] QString RoleText(Api::ChatParticipant::Type type) {
+	using Type = Api::ChatParticipant::Type;
+	switch (type) {
+	case Type::Creator: return u"создатель"_q;
+	case Type::Admin: return u"админ"_q;
+	case Type::Member: return u"участник"_q;
+	case Type::Restricted: return u"ограничен"_q;
+	case Type::Banned: return u"заблокирован"_q;
+	case Type::Left: return u"вышел"_q;
+	}
+	return QString();
+}
+
+// Строка выгрузки: участник или тот, кто был в чате по истории.
+struct MemberRow {
+	UserId id = 0;
+	QString firstName;
+	QString lastName;
+	QString username;
+	QString usernames;
+	QString phone;
+	QString role;
+	QString rank;
+	TimeId joined = 0;
+	QString lastseen;
+	bool bot = false;
+	bool deleted = false;
+	bool premium = false;
+	bool premiumToWrite = false;
+	bool scamFake = false;
+	int count = 0;
+	TimeId first = 0;
+	TimeId last = 0;
+	MsgId lastId = 0;
+	QString lastText;
+	MsgId joinId = 0;
+	TimeId left = 0;
+	bool listed = false;
+	uint64 accessHash = 0;
+};
+
+[[nodiscard]] bool Messageable(const MemberRow &r) {
+	return !r.bot
+		&& !r.deleted
+		&& (r.accessHash || r.lastId || r.joinId || r.listed);
+}
+
+[[nodiscard]] std::vector<MemberRow> BuildMemberRows(
+		not_null<ChannelData*> channel,
+		const MembersLoad &members,
+		const HistoryScan &history,
+		const Engagement &extra,
+		const ExportOptions &options) {
+	auto admins = std::vector<MemberRow>();
+	auto result = std::vector<MemberRow>();
+	const auto add = [&](std::vector<MemberRow> &to, UserId id, const QString &role, const QString &rank, TimeId joined, bool listed) {
+		const auto user = channel->owner().userLoaded(id);
+		const auto stats = history.authors.find(id);
+		const auto has = (stats != end(history.authors));
+		auto all = QStringList();
+		if (user) {
+			for (const auto &name : user->usernames()) {
+				all.push_back(name);
+			}
+		}
+		auto r = MemberRow{
+			.id = id,
+			.role = role,
+			.rank = rank,
+			.joined = joined,
+			.listed = listed,
+		};
+		if (user) {
+			r.firstName = user->firstName;
+			r.lastName = user->lastName;
+			r.username = user->username();
+			r.usernames = all.join(u", "_q);
+			r.phone = user->phone();
+			r.lastseen = LastseenText(user);
+			r.bot = user->isBot();
+			r.deleted = user->isInaccessible();
+			r.premium = user->isPremium();
+			r.premiumToWrite = user->requiresPremiumToWrite();
+			r.scamFake = user->isScam() || user->isFake();
+			// Ключ доступа: с ним личку можно открыть даже когда список
+			// участников скрыт и человек ни разу не писал.
+			r.accessHash = user->accessHash();
+		}
+		if (has) {
+			const auto &s = stats->second;
+			r.count = s.count;
+			r.first = s.first;
+			r.last = s.last;
+			r.lastId = s.lastId;
+			r.lastText = s.lastText.left(1000);
+			r.joinId = s.joinId;
+			r.left = s.left;
+			if (!r.joined) {
+				r.joined = s.joined;
+			}
+		}
+		to.push_back(std::move(r));
+	};
+	auto written = base::flat_set<UserId>();
+	for (const auto &p : members.list) {
+		// Админы и создатель — команда чата: по умолчанию их в таблице нет,
+		// а по настройке они идут первыми строками, чтобы легко найти
+		// (решение владельца 24.10.2026).
+		written.emplace(p.userId());
+		if (p.isCreatorOrAdmin()) {
+			if (options.includeAdmins) {
+				add(admins, p.userId(), RoleText(p.type()), p.rank(), 0, true);
+			}
+			continue;
+		}
+		const auto joined = p.memberSince()
+			? p.memberSince()
+			: p.promotedSince();
+		add(result, p.userId(), RoleText(p.type()), p.rank(), joined, true);
+	}
+	for (const auto &[id, stats] : history.authors) {
+		if (written.contains(id)) {
+			continue;
+		}
+		// Список участников скрыт, и кто в чате, видно только по истории:
+		// вышел, если последнее событие о нём — выход.
+		const auto gone = stats.left
+			&& stats.left >= stats.joined
+			&& stats.left >= stats.last;
+		add(
+			result,
+			id,
+			gone ? u"вышел"_q : u"участник"_q,
+			QString(),
+			stats.joined,
+			false);
+		written.emplace(id);
+	}
+	// Молчащие, которых видно только по реакциям, опросам и упоминаниям.
+	for (const auto &[id, source] : extra.found) {
+		if (written.contains(id)) {
+			continue;
+		}
+		add(result, id, source, QString(), 0, false);
+		written.emplace(id);
+	}
+	// Сначала писавшие, больше сообщений выше; потом молчащие, недавно
+	// вступившие выше.
+	ranges::stable_sort(result, [](const MemberRow &a, const MemberRow &b) {
+		if (a.count != b.count) {
+			return a.count > b.count;
+		}
+		return a.joined > b.joined;
+	});
+	if (options.onlyMessageable) {
+		result.erase(
+			ranges::remove_if(result, [](const MemberRow &r) {
+				return !Messageable(r);
+			}),
+			end(result));
+	}
+	// Админы первыми строками, дальше остальные.
+	result.insert(begin(result), admins.begin(), admins.end());
+	return result;
+}
+
+// Ссылка "написать": открывает личку в Telegram Team от этого аккаунта.
+// Через сообщение человека, а молчащему через запись о его вступлении:
+// когда список участников скрыт, иначе сервер его не отдаёт.
+[[nodiscard]] QString WriteLinkFor(
+		const MemberRow &row,
+		ChannelId channelId,
+		UserId account) {
+	if (row.bot || row.deleted) {
+		return QString();
+	}
+	// Ссылки ведут в ту копию клиента, которая выгружала: аккаунт, читающий
+	// группу, есть только в ней. Ключ доступа в ссылке (hash) открывает личку
+	// даже тому, кто ни разу не писал и кого нет в видимом списке участников.
+	const auto scheme = Application::OwnUrlScheme();
+	auto query = u"channel=%1&user=%2&account=%3"_q
+		.arg(QString::number(channelId.bare))
+		.arg(QString::number(row.id.bare))
+		.arg(QString::number(account.bare));
+	if (row.accessHash) {
+		query += u"&hash=%1"_q.arg(QString::number(row.accessHash));
+	}
+	const auto post = row.lastId ? row.lastId : row.joinId;
+	if (post) {
+		return scheme + u"://authorchat?post=%1&"_q.arg(post.bare) + query;
+	} else if (row.accessHash || row.listed) {
+		return scheme + u"://memberchat?"_q + query;
+	}
+	return QString();
+}
+
+[[nodiscard]] QString WriteMembersTsv(
+		const std::vector<MemberRow> &rows,
+		const QString &path) {
+	auto lines = QStringList();
+	lines.push_back(QStringList{
+		u"user_id"_q,
+		u"first_name"_q,
+		u"last_name"_q,
+		u"username"_q,
+		u"usernames"_q,
+		u"phone"_q,
+		u"role"_q,
+		u"rank"_q,
+		u"joined"_q,
+		u"lastseen"_q,
+		u"bot"_q,
+		u"deleted"_q,
+		u"premium"_q,
+		u"premium_to_write"_q,
+		u"scam_fake"_q,
+		u"msg_count"_q,
+		u"first_msg"_q,
+		u"last_msg"_q,
+		u"last_msg_id"_q,
+		u"last_text"_q,
+		u"join_msg_id"_q,
+		u"left"_q,
+	}.join(QChar('\t')));
+	const auto yes = [](bool value) {
+		return value ? u"да"_q : QString();
+	};
+	const auto number = [](auto value) {
+		return value ? QString::number(value) : QString();
+	};
+	for (const auto &r : rows) {
+		lines.push_back(QStringList{
+			QString::number(r.id.bare),
+			TsvField(r.firstName),
+			TsvField(r.lastName),
+			r.username,
+			r.usernames,
+			r.phone,
+			r.role,
+			TsvField(r.rank),
+			TsvDate(r.joined),
+			r.lastseen,
+			yes(r.bot),
+			yes(r.deleted),
+			yes(r.premium),
+			yes(r.premiumToWrite),
+			yes(r.scamFake),
+			number(r.count),
+			TsvDate(r.first),
+			TsvDate(r.last),
+			number(r.lastId.bare),
+			TsvField(r.lastText),
+			number(r.joinId.bare),
+			TsvDate(r.left),
+		}.join(QChar('\t')));
+	}
+	auto file = QFile(path);
+	if (!file.open(QIODevice::WriteOnly | QIODevice::Truncate)) {
+		return u"не удалось записать файл %1"_q.arg(path);
+	}
+	file.write("\xEF\xBB\xBF");
+	file.write(lines.join(QChar('\n')).toUtf8());
+	file.write("\n");
+	return QString();
+}
+
+// Таблица Excel (.xlsx) без сторонних библиотек: это zip-архив из
+// нескольких XML-файлов, а архиватор в клиенте уже есть.
+class XlsxZip final {
+public:
+	explicit XlsxZip(const QString &path) : _file(path) {
+		auto funcs = zlib_filefunc64_def();
+		funcs.opaque = this;
+		funcs.zopen64_file = [](voidpf opaque, const void *, int) -> voidpf {
+			const auto self = static_cast<XlsxZip*>(opaque);
+			return self->_file.open(QIODevice::ReadWrite | QIODevice::Truncate)
+				? self
+				: nullptr;
+		};
+		funcs.zread_file = [](voidpf opaque, voidpf, void *buf, uLong size) {
+			const auto read = static_cast<XlsxZip*>(opaque)->_file.read(
+				static_cast<char*>(buf),
+				size);
+			return (read > 0) ? uLong(read) : uLong(0);
+		};
+		funcs.zwrite_file = [](voidpf opaque, voidpf, const void *buf, uLong size) {
+			const auto written = static_cast<XlsxZip*>(opaque)->_file.write(
+				static_cast<const char*>(buf),
+				size);
+			return (written >= 0) ? uLong(written) : uLong(0);
+		};
+		funcs.ztell64_file = [](voidpf opaque, voidpf) {
+			return ZPOS64_T(static_cast<XlsxZip*>(opaque)->_file.pos());
+		};
+		funcs.zseek64_file = [](voidpf opaque, voidpf, ZPOS64_T offset, int origin) {
+			auto &file = static_cast<XlsxZip*>(opaque)->_file;
+			const auto position = (origin == ZLIB_FILEFUNC_SEEK_SET)
+				? int64(offset)
+				: (origin == ZLIB_FILEFUNC_SEEK_CUR)
+				? (file.pos() + int64(offset))
+				: (file.size() + int64(offset));
+			return file.seek(position) ? 0L : -1L;
+		};
+		funcs.zclose_file = [](voidpf opaque, voidpf) {
+			static_cast<XlsxZip*>(opaque)->_file.close();
+			return 0;
+		};
+		funcs.zerror_file = [](voidpf opaque, voidpf) {
+			return (static_cast<XlsxZip*>(opaque)->_file.error()
+				== QFileDevice::NoError) ? 0 : -1;
+		};
+		_zip = zipOpen2_64("", APPEND_STATUS_CREATE, nullptr, &funcs);
+	}
+
+	[[nodiscard]] bool add(const char *name, const QByteArray &data) {
+		if (!_zip) {
+			return false;
+		}
+		auto info = zip_fileinfo();
+		const auto now = QDateTime::currentDateTime();
+		info.tmz_date.tm_sec = now.time().second();
+		info.tmz_date.tm_min = now.time().minute();
+		info.tmz_date.tm_hour = now.time().hour();
+		info.tmz_date.tm_mday = now.date().day();
+		info.tmz_date.tm_mon = now.date().month() - 1;
+		info.tmz_date.tm_year = now.date().year();
+		if (zipOpenNewFileInZip(
+				_zip,
+				name,
+				&info,
+				nullptr,
+				0,
+				nullptr,
+				0,
+				nullptr,
+				Z_DEFLATED,
+				Z_DEFAULT_COMPRESSION) != ZIP_OK) {
+			return false;
+		}
+		const auto ok = (zipWriteInFileInZip(
+			_zip,
+			data.constData(),
+			uInt(data.size())) == ZIP_OK);
+		return (zipCloseFileInZip(_zip) == ZIP_OK) && ok;
+	}
+
+	[[nodiscard]] bool finish() {
+		return _zip && (zipClose(base::take(_zip), nullptr) == ZIP_OK);
+	}
+
+	~XlsxZip() {
+		if (_zip) {
+			zipClose(_zip, nullptr);
+		}
+	}
+
+private:
+	QFile _file;
+	zipFile _zip = nullptr;
+
+};

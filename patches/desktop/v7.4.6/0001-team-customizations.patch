+// Письмо незнакомцу уходит только от явно названного аккаунта: активный
+// может оказаться основным (так и вышло 22.10.2026). Пометку via_account
+// ставит Application::switchAccountForStartUrls.
+[[nodiscard]] bool AccountConfirmed(
+		not_null<Window::SessionController*> controller,
+		const QMap<QString, QString> &params) {
+	if (params.value(u"via_account"_q) == u"0"_q) {
+		return false;
+	} else if (params.value(u"via_account"_q) != u"1"_q) {
+		controller->window().showToast(u"Личка не открыта: в ссылке нет "
+			"аккаунта или такого аккаунта здесь нет (account=имя или номер)."_q);
+		return false;
+	}
+	return true;
+}
+
+// Человек по номеру и ключу доступа из ссылки. Ключ (hash) в ссылке позволяет
+// открыть личку даже тому, кого нет в видимом списке участников и кто ни разу
+// не писал: сервер отдал его только в списке реакций или опроса при выгрузке.
+[[nodiscard]] UserData *UserFromParams(
+		not_null<Main::Session*> session,
+		const QMap<QString, QString> &params) {
+	const auto id = UserId(params.value(u"user"_q).toULongLong());
+	if (!id) {
+		return nullptr;
+	}
+	const auto known = session->data().userLoaded(id);
+	if (known && known->accessHash()) {
+		return known;
+	}
+	const auto hash = params.value(u"hash"_q).toULongLong();
+	if (!hash) {
+		return known;
+	}
+	const auto user = session->data().user(id);
+	user->setAccessHash(hash);
+	return user;
+}

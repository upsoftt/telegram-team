+void Account::initializeAccountProxy() {
+	const auto userId = sessionExists() ? session().userId() : _sessionUserId;
+	const auto user = QString::number(userId.bare);
+	const auto configuredManifest = qEnvironmentVariable("TGTEAM_PROXY_MANIFEST");
+	const auto manifest = configuredManifest.isEmpty()
+		? qEnvironmentVariable("LOCALAPPDATA") + QStringLiteral("/TelegramTeam/teambase-proxies.json")
+		: configuredManifest;
+	const auto cache = cWorkingDir() + QStringLiteral("tdata/teambase-proxy-") + user + QStringLiteral(".json");
+	if (userId && !_proxyCustomized) {
+		if (const auto route = Core::ReadTeamBaseRoute(user, manifest, cache)) {
+			auto proxy = MTP::ProxyData();
+			proxy.type = MTP::ProxyData::Type::Socks5;
+			proxy.host = QStringLiteral("127.0.0.1");
+			proxy.port = route->port;
+			proxy.user = route->user;
+			proxy.password = route->token;
+			if (!_accountProxySettings) {
+				_accountProxySettings = std::make_unique<Core::SettingsProxy>();
+				_accountProxySettings->setFromSerialized(Core::App().settings().proxy().serialize());
+			}
+			_accountProxySettings->setSelected(proxy);
+			if (_accountProxySettings->indexInList(proxy) < 0) {
+				_accountProxySettings->addToList(proxy);
+			}
+			_accountProxySettings->setSettings(MTP::ProxyData::Settings::Enabled);
+			_accountProxySettings->setUseProxyForCalls(true);
+			_accountProxySettings->setProxyRotationEnabled(false);
+			LOG(("TeamBase proxy: user=%1 exit=%2 via=127.0.0.1:%3").arg(user, route->exitIp).arg(route->port));
+		}
+	}

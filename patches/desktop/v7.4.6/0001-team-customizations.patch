+void ExportChatMembers(
+		not_null<Window::SessionController*> controller,
+		not_null<ChannelData*> channel) {
+	auto name = channel->name();
+	name = name.replace(
+		QRegularExpression(u"[\\\\/:*?\"<>|]"_q),
+		u" "_q).trimmed();
+	const auto out = u"%1/%2 участники %3.xlsx"_q.arg(
+		QStandardPaths::writableLocation(QStandardPaths::DownloadLocation),
+		name.isEmpty() ? QString::number(peerToChannel(channel->id).bare) : name,
+		QDate::currentDate().toString(u"yyyy-MM-dd"_q));
+	// Перед выгрузкой — окно с настройками. Число сообщений узнаём одним
+	// запросом, чтобы показать оценку времени.
+	const auto weak = base::make_weak(controller);
+	channel->session().api().request(MTPmessages_GetHistory(
+		channel->input(),
+		MTP_int(0), MTP_int(0), MTP_int(0), MTP_int(1),
+		MTP_int(0), MTP_int(0), MTP_long(0)
+	)).done([=](const MTPmessages_Messages &result) {
+		auto total = 0;
+		result.match([&](const MTPDmessages_messages &d) {
+			total = int(d.vmessages().v.size());
+		}, [&](const MTPDmessages_messagesSlice &d) {
+			total = d.vcount().v;
+		}, [&](const MTPDmessages_channelMessages &d) {
+			total = d.vcount().v;
+		}, [](const MTPDmessages_messagesNotModified &) {
+		});
+		if (const auto strong = weak.get()) {
+			ShowExportMembersBox(strong, channel, out, total);
+		}
+	}).fail([=] {
+		if (const auto strong = weak.get()) {
+			ShowExportMembersBox(strong, channel, out, 0);
+		}
+	}).send();
+}
+
+void ExportChannelAudience(
+		not_null<Window::SessionController*> controller,
+		not_null<ChannelData*> channel) {
+	// У канала Telegram не показывает ни подписчиков, ни тех, кто ставил
+	// реакции (они анонимные), ни голосовавших (опросы в каналах только
+	// анонимные). Видны люди только в группе обсуждения, где живут
+	// комментарии к постам: её и выгружаем тем же способом, что группу.
+	const auto weak = base::make_weak(controller);
+	const auto go = [=] {
+		const auto strong = weak.get();
+		if (!strong) {
+			return;
+		}
+		const auto linked = channel->discussionLink();
+		if (!linked) {
+			strong->window().showToast(u"У канала \"%1\" нет группы "
+				"обсуждения. Подписчиков, реакции и опросы канала Telegram "
+				"не показывает, выгружать некого."_q.arg(channel->name()),
+				crl::time(8000));
+			return;
+		}
+		strong->window().showToast(u"Выгружаю комментаторов канала "
+			"\"%1\" из группы обсуждения \"%2\"."_q
+			.arg(channel->name(), linked->name()));
+		ExportChatMembers(strong, linked);
+	};
+	if (channel->discussionLinkKnown()) {
+		go();
+		return;
+	}
+	channel->session().changes().peerUpdates(
+		channel,
+		Data::PeerUpdate::Flag::FullInfo
+	) | rpl::filter([=](const Data::PeerUpdate &) {
+		return channel->discussionLinkKnown();
+	}) | rpl::take(1) | rpl::on_next([=](const Data::PeerUpdate &) {
+		go();
+	}, controller->lifetime());
+	channel->session().api().requestFullPeer(channel);
+}

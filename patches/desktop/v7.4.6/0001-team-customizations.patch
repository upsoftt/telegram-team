+// LeadSearcher: у второй копии клиента ("Телеграм Тим База", своя схема
+// ссылок) логотип пурпурный вместо голубого, чтобы окна и значки двух копий
+// не путались (просьба владельца 23.10.2026, цвет #F20EFF). Голубые точки
+// перекрашиваются с сохранением яркости, белый самолётик остаётся белым.
+[[nodiscard]] QImage ForThisCopy(QImage image) {
+	if (Core::Application::OwnUrlScheme() == u"tgteam"_q) {
+		return image;
+	}
+	image = std::move(image).convertToFormat(QImage::Format_ARGB32);
+	for (auto y = 0; y != image.height(); ++y) {
+		const auto line = reinterpret_cast<QRgb*>(image.scanLine(y));
+		for (auto x = 0; x != image.width(); ++x) {
+			const auto pixel = line[x];
+			const auto r = qRed(pixel), g = qGreen(pixel), b = qBlue(pixel);
+			if (b <= std::max(r, g)) {
+				continue;
+			}
+			// Насколько точка отличается от белого, настолько она пурпурная:
+			// голубой круг целиком, сглаженный край самолётика частично.
+			const auto k = std::min(1., (255 - std::min({ r, g, b })) / 200.);
+			const auto to = [&](int target) {
+				return int(std::clamp(255 - (255 - target) * k, 0., 255.));
+			};
+			line[x] = qRgba(to(0xF2), to(0x0E), to(0xFF), qAlpha(pixel));
+		}
+	}
+	return image;
+}
+
 const QImage &Logo() {
-	static const auto result = QImage(u":/gui/art/logo_256.png"_q);
+	static const auto result = ForThisCopy(
+		QImage(u":/gui/art/logo_256.png"_q));
 	return result;
 }
 
 const QImage &LogoNoMargin() {
-	static const auto result = QImage(u":/gui/art/logo_256_no_margin.png"_q);
+	static const auto result = ForThisCopy(
+		QImage(u":/gui/art/logo_256_no_margin.png"_q));

+// LeadSearcher: tg://memberchat?channel=<id>&user=<номер>&account=<аккаунт>
+// открывает личку с участником группы по его номеру, даже если он ни разу
+// не писал и у него нет публичного имени. Сервер отдаёт такого человека
+// только в списке участников, поэтому при первом обращении после запуска
+// список подгружается целиком.
+bool ResolveMemberChat(
+		Window::SessionController *controller,
+		const Match &match,
+		const QVariant &context) {
+	if (!controller) {
+		return false;
+	}
+	const auto params = url_parse_params(
+		match->captured(1),
+		qthelp::UrlParamNameTransform::ToLower);
+	const auto channelId = ChannelId(
+		params.value(u"channel"_q).toULongLong());
+	const auto userId = UserId(params.value(u"user"_q).toULongLong());
+	if (!channelId || !userId) {
+		return false;
+	} else if (!AccountConfirmed(controller, params)) {
+		return true;
+	}
+	const auto msgId = MsgId(params.value(u"post"_q).toInt());
+	const auto draft = LinkDraftFromParams(
+		params,
+		IsServerMsgId(msgId)
+			? u"https://t.me/c/%1/%2"_q.arg(channelId.bare).arg(msgId.bare)
+			: QString());
+	const auto weak = base::make_weak(controller);
+	const auto open = [=](not_null<UserData*> user) {
+		const auto strong = weak.get();
+		if (!strong) {
+			return;
+		}
+		if (user->isSelf() || user->isBot() || user->isInaccessible()) {
+			strong->window().showToast(
+				u"Этому участнику написать нельзя: это вы, бот или "
+				"удалённый аккаунт."_q);
+			return;
+		}
+		if (!draft.text.isEmpty()) {
+			Data::SetChatLinkDraft(user, draft);
+		}
+		strong->showPeerHistory(user);
+		strong->window().activate();
+	};
+	// Ключ доступа из ссылки (hash) открывает личку сразу, без поиска по
+	// списку участников: он всё равно скрыт в этом чате.
+	if (const auto user = UserFromParams(&controller->session(), params)) {
+		if (user->accessHash()) {
+			open(not_null<UserData*>(user));
+			return true;
+		}
+	}
+	const auto known = [=](not_null<Main::Session*> session) {
+		const auto user = session->data().userLoaded(userId);
+		return (user && user->accessHash()) ? user : nullptr;
+	};
+	const auto channel = controller->session().data().channelLoaded(channelId);
+	if (!channel) {
+		controller->window().showToast(u"Этот аккаунт не состоит в чате, "
+			"где состоит человек. Вступите в чат и повторите."_q);
+		return true;
+	}
+	controller->window().showToast(u"Ищу человека среди участников чата…"_q);
+	LoadAllMembers(channel, [=](std::shared_ptr<MembersLoad> members) {
+		if (const auto user = known(members->session)) {
+			open(not_null<UserData*>(user));
+		} else if (const auto strong = weak.get()) {
+			strong->window().showToast(u"Человека нет среди участников "
+				"чата: он вышел или скрыт. Откройте личку по ссылке на его "
+				"сообщение."_q);
+		}
+	});
+	return true;
+}

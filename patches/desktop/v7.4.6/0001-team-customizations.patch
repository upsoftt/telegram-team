+bool Application::switchAccountForStartUrls() {
+	auto switched = false;
+	auto relayedAway = false;
+	for (auto &url : cRefStartUrls()) {
+		if (url.scheme() != u"tgteam"_q && url.scheme() != OwnUrlScheme()) {
+			continue;
+		}
+		const auto original = url;
+		auto query = QUrlQuery(url.query());
+		const auto relayed = query.hasQueryItem(u"relayed"_q);
+		query.removeAllQueryItems(u"relayed"_q);
+		// Кириллица в имени аккаунта приходит из браузера в виде %D0%9F…,
+		// и QUrlQuery её не раскрывает (22.10.2026 "Павел Dictator" не
+		// нашёлся). Раскрываем сами, пока строка меняется.
+		auto requestedText = query.queryItemValue(
+			u"account"_q,
+			QUrl::FullyDecoded).trimmed();
+		for (auto i = 0; i != 3; ++i) {
+			const auto decoded = QUrl::fromPercentEncoding(
+				requestedText.toUtf8()).trimmed();
+			if (decoded == requestedText) {
+				break;
+			}
+			requestedText = decoded;
+		}
+		const auto requested = requestedText.toULongLong();
+		query.removeAllQueryItems(u"account"_q);
+		query.removeAllQueryItems(u"via_account"_q);
+
+		// Аккаунт называется номером пользователя или, когда номера под рукой
+		// нет, именем, как оно видно в списке аккаунтов (`account=Paul`).
+		const auto account = requested
+			? accountByUserId(requested)
+			: requestedText.isEmpty()
+			? nullptr
+			: accountByName(requestedText);
+		if (account) {
+			// Личка автору сообщения открывается только с этой пометкой:
+			// без неё письмо незнакомцу ушло бы от того аккаунта, который
+			// случайно оказался активным (22.10.2026 так открылся основной).
+			query.addQueryItem(u"via_account"_q, u"1"_q);
+		} else if (!requestedText.isEmpty()) {
+			// Причину уже назовёт плашка ниже, обработчику остаётся молчать.
+			query.addQueryItem(u"via_account"_q, u"0"_q);
+		}
+
+		// Дальше ссылку разбирают обычные обработчики, они знают только tg://.
+		url.setScheme(u"tg"_q);
+		url.setQuery(query);
+
+		if (requestedText.isEmpty()) {
+			continue;
+		}
+		if (!account && !relayed && !requestedText.isEmpty()
+			&& _domain->started()) {
+			// Аккаунт живёт во второй копии клиента (основная tgteam:// и
+			// "База" со своей схемой): отдаём ссылку ей, а здесь не открываем.
+			// Пометка relayed не даёт копиям гонять ссылку друг другу, когда
+			// аккаунта нет ни в одной (25.10.2026 ссылка службы открыла Базу,
+			// где нужного аккаунта не было).
+			auto other = original;
+			other.setScheme((OwnUrlScheme() == u"tgteam"_q)
+				? u"tgbase"_q
+				: u"tgteam"_q);
+			const auto rest = original.query(QUrl::FullyEncoded);
+			other.setQuery(
+				rest + (rest.isEmpty() ? u""_q : u"&"_q) + u"relayed=1"_q,
+				QUrl::StrictMode);
+			if (QDesktopServices::openUrl(other)) {
+				url = QUrl();
+				relayedAway = true;
+				continue;
+			}
+		}
+		if (!account) {
+			// Молча открыть чужим аккаунтом хуже, чем не переключиться:
+			// ответ ушёл бы не от того человека.
+			if (_lastActivePrimaryWindow) {
+				// По имени ошибаются чаще, чем по номеру: аккаунт переименовали,
+				// и прежнее имя в ссылке больше не совпадает. Поэтому плашка
+				// называет, какие аккаунты здесь есть.
+				auto names = QStringList();
+				for (const auto &withIndex : _domain->accounts()) {
+					if (const auto s = withIndex.account->maybeSession()) {
+						names.push_back(s->user()->name());
+					}
+				}
+				_lastActivePrimaryWindow->showToast(requested
+					? (relayed
+						? u"Аккаунт %1 не подключён ни в одной копии Telegram Team."_q
+						: u"Аккаунт %1 не подключён здесь."_q).arg(requested)
+					: u"Аккаунта \"%1\" здесь нет или их два. Есть: %2."_q
+						.arg(requestedText, names.join(u", "_q)));
+			}
+			continue;
+		}
+		if (&_domain->active() != account) {
+			_domain->activate(account);
+			switched = true;
+		}
+	}
+	if (relayedAway) {
+		cRefStartUrls().removeAll(QUrl());
+	}
+	return switched;
+}

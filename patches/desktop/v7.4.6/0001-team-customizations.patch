+// LeadSearcher: tg://authorchat?channel=<id>&post=<номер>&text=<черновик>
+// открывает личный чат с автором сообщения из закрытой группы и ставит
+// черновик. Имени и номера автора у владельца нет, есть только ссылка на
+// его сообщение: открывать чат, искать сообщение и жать на имя приходилось
+// руками для каждого человека. Слова в [квадратных скобках] становятся
+// ссылкой на это сообщение, чтобы собеседник сразу видел, о чём речь,
+// а [слова](https://…) — ссылкой на указанный адрес.
+bool ResolveAuthorChat(
+		Window::SessionController *controller,
+		const Match &match,
+		const QVariant &context) {
+	if (!controller) {
+		return false;
+	}
+	const auto params = url_parse_params(
+		match->captured(1),
+		qthelp::UrlParamNameTransform::ToLower);
+	const auto channelId = ChannelId(
+		params.value(u"channel"_q).toULongLong());
+	const auto msgId = MsgId(params.value(u"post"_q).toInt());
+	if (!channelId || !IsServerMsgId(msgId)) {
+		return false;
+	}
+	if (!AccountConfirmed(controller, params)) {
+		return true;
+	}
+	const auto draft = LinkDraftFromParams(
+		params,
+		u"https://t.me/c/%1/%2"_q.arg(channelId.bare).arg(msgId.bare));
+
+	const auto session = &controller->session();
+	const auto channel = session->data().channelLoaded(channelId);
+	if (!channel) {
+		controller->window().showToast(u"Этот аккаунт не состоит в чате, "
+			"где написано сообщение. Вступите в чат и повторите."_q);
+		return true;
+	}
+	const auto weak = base::make_weak(controller);
+	const auto show = [=] {
+		const auto strong = weak.get();
+		if (!strong) {
+			return;
+		}
+		const auto item = strong->session().data().message(channel, msgId);
+		if (!item) {
+			strong->window().showToast(
+				u"Сообщение не найдено: его удалили или чат недоступен."_q);
+			return;
+		}
+		// user=<номер> — писать не автору, а этому человеку из сообщения:
+		// в записи "X добавил Y" автор X, а нужен Y. Ключ доступа берётся из
+		// ссылки или из уже загруженных данных.
+		const auto wanted = UserId(params.value(u"user"_q).toULongLong());
+		const auto named = UserFromParams(&strong->session(), params);
+		if (wanted && (!named || !named->accessHash())) {
+			strong->window().showToast(
+				u"Человек из этого сообщения не найден."_q);
+			return;
+		}
+		const auto author = named ? not_null<PeerData*>(named) : item->from();
+		if (!author->isUser() || author->isSelf()) {
+			strong->window().showToast(
+				u"У этого сообщения нет автора, которому можно написать."_q);
+			return;
+		}
+		if (!draft.text.isEmpty()) {
+			Data::SetChatLinkDraft(author, draft);
+		}
+		strong->showPeerHistory(author);
+		strong->window().activate();
+	};
+	if (session->data().message(channel, msgId)) {
+		show();
+	} else {
+		session->api().requestMessageData(channel, msgId, show);
+	}
+	return true;
+}

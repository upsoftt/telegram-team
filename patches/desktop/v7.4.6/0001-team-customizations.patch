+// LeadSearcher: tg://exportmembers?channel=<id>&out=<файл .tsv или .xlsx>
+// выгружает всех участников группы и всех, кто в ней писал или вступал.
+// Владелец ведёт по чату базу людей, а Telegram Desktop умеет выгрузить
+// только переписку, без списка участников и без номеров людей. То же
+// делает пункт "Выгрузить участников в Excel" в меню группы.
+bool ExportMembers(
+		Window::SessionController *controller,
+		const Match &match,
+		const QVariant &context) {
+	if (!controller) {
+		return false;
+	}
+	const auto params = url_parse_params(
+		match->captured(1),
+		qthelp::UrlParamNameTransform::ToLower);
+	const auto channelId = ChannelId(
+		params.value(u"channel"_q).toULongLong());
+	if (!channelId) {
+		return false;
+	} else if (params.value(u"via_account"_q) == u"0"_q) {
+		return true;
+	}
+	const auto channel = controller->session().data().channelLoaded(channelId);
+	if (!channel) {
+		controller->window().showToast(u"Этот аккаунт не состоит в чате "
+			"%1, выгружать нечего."_q.arg(channelId.bare));
+		return true;
+	}
+	const auto out = params.value(u"out"_q).isEmpty()
+		? u"%1/tgteam-members-%2.tsv"_q.arg(
+			QStandardPaths::writableLocation(
+				QStandardPaths::DownloadLocation),
+			QString::number(channelId.bare))
+		: params.value(u"out"_q);
+	RunMembersExport(controller, channel, out, false, ExportOptions());
+	return true;
+}

+// Грубая оценка времени выгрузки. Основное время — опрос реакций: по запросу
+// на сообщение с реакцией, с паузой между запросами. Точного числа таких
+// сообщений заранее нет, берём долю от всех.
+[[nodiscard]] QString EstimateText(int totalMessages, const ExportOptions &o) {
+	const auto pause = kMembersPagePause / 1000.;
+	auto seconds = (totalMessages / 100. + 1) * pause; // страницы истории
+	if (o.reactions) {
+		seconds += totalMessages * 0.6 * pause;
+	}
+	if (o.polls) {
+		seconds += 10 * pause;
+	}
+	const auto minutes = std::max(1, int(std::ceil(seconds / 60.)));
+	return u"примерно %1 мин"_q.arg(minutes);
+}
+
+// Окно настроек перед выгрузкой, по образцу окна "Экспорт истории чата":
+// сведения о группе, оценка времени, путь и настройки выгрузки.
+void ShowExportMembersBox(
+		not_null<Window::SessionController*> controller,
+		not_null<ChannelData*> channel,
+		QString out,
+		int totalMessages) {
+	const auto weak = base::make_weak(controller);
+	controller->show(Box([=](not_null<Ui::GenericBox*> box) {
+		box->setTitle(rpl::single(u"Выгрузить участников"_q));
+
+		const auto members = channel->membersCount();
+		box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			u"Группа: %1\nУчастников: %2\nСообщений в чате: %3"_q
+				.arg(channel->name())
+				.arg(members > 0 ? QString::number(members) : u"скрыто"_q)
+				.arg(totalMessages > 0 ? QString::number(totalMessages) : u"?"_q),
+			st::boxLabel));
+
+		const auto admins = box->addRow(object_ptr<Ui::Checkbox>(
+			box,
+			u"Включить админов (первыми строками)"_q,
+			false));
+		const auto reactions = box->addRow(object_ptr<Ui::Checkbox>(
+			box,
+			u"Искать молчащих по реакциям (дольше)"_q,
+			true));
+		const auto polls = box->addRow(object_ptr<Ui::Checkbox>(
+			box,
+			u"Искать по опросам"_q,
+			true));
+		const auto mentions = box->addRow(object_ptr<Ui::Checkbox>(
+			box,
+			u"Искать по упоминаниям"_q,
+			true));
+		const auto onlyMessageable = box->addRow(object_ptr<Ui::Checkbox>(
+			box,
+			u"Только те, кому можно написать"_q,
+			false));
+
+		const auto gather = [=] {
+			auto o = ExportOptions();
+			o.includeAdmins = admins->checked();
+			o.reactions = reactions->checked();
+			o.polls = polls->checked();
+			o.mentions = mentions->checked();
+			o.onlyMessageable = onlyMessageable->checked();
+			return o;
+		};
+
+		const auto estimate = box->addRow(object_ptr<Ui::FlatLabel>(
+			box,
+			u"Время: %1\nФайл: %2"_q
+				.arg(EstimateText(totalMessages, gather()))
+				.arg(QDir::toNativeSeparators(out)),
+			st::boxDividerLabel));
+		const auto recalc = [=] {
+			estimate->setText(u"Время: %1\nФайл: %2"_q
+				.arg(EstimateText(totalMessages, gather()))
+				.arg(QDir::toNativeSeparators(out)));
+		};
+		for (const auto c : { reactions, polls }) {
+			c->checkedChanges() | rpl::on_next([=](bool) {
+				recalc();
+			}, box->lifetime());
+		}
+
+		box->addButton(rpl::single(u"Выгрузить"_q), [=] {
+			const auto options = gather();
+			box->closeBox();
+			if (const auto strong = weak.get()) {
+				RunMembersExport(strong, channel, out, true, options);
+			}
+		});
+		box->addButton(tr::lng_cancel(), [=] { box->closeBox(); });
+	}));
+}

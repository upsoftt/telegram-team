diff --git a/Telegram/SourceFiles/core/teambase_proxy.h b/Telegram/SourceFiles/core/teambase_proxy.h
new file mode 100644
index 0000000000..1eaf568c1c
--- /dev/null
+++ b/Telegram/SourceFiles/core/teambase_proxy.h
@@ -0,0 +1,86 @@
+#pragma once
+
+#include <QtCore/QFile>
+#include <QtCore/QFileInfo>
+#include <QtCore/QDir>
+#include <QtCore/QJsonArray>
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QSaveFile>
+#include <optional>
+
+namespace Core {
+
+struct TeamBaseRoute {
+	int port = 1;
+	QString user;
+	QString token;
+	QString exitIp;
+};
+
+inline std::optional<TeamBaseRoute> ParseTeamBaseRoute(
+		const QByteArray &data,
+		const QString &user) {
+	const auto document = QJsonDocument::fromJson(data);
+	const auto root = document.object();
+	const auto port = root.value("port").toInt();
+	if (root.value("version").toInt() != 1
+		|| root.value("host").toString() != QStringLiteral("127.0.0.1")
+		|| port < 1 || port > 65535
+		|| !root.value("accounts").isArray()) {
+		return std::nullopt;
+	}
+	std::optional<TeamBaseRoute> result;
+	for (const auto entry : root.value("accounts").toArray()) {
+		const auto account = entry.toObject();
+		if (account.value("user_id").toString() != user) {
+			continue;
+		}
+		if (result) {
+			return std::nullopt;
+		}
+		const auto token = account.value("token").toString();
+		if (token.size() != 64) {
+			return std::nullopt;
+		}
+		for (const auto ch : token) {
+			if (!((ch >= QChar('0') && ch <= QChar('9'))
+				|| (ch >= QChar('a') && ch <= QChar('f')))) {
+				return std::nullopt;
+			}
+		}
+		result = TeamBaseRoute{port, user, token, account.value("exit_ip").toString()};
+	}
+	return result;
+}
+
+inline std::optional<TeamBaseRoute> ReadTeamBaseRoute(
+		const QString &user,
+		const QString &manifestPath,
+		const QString &cachePath) {
+	QFile manifest(manifestPath);
+	if (manifest.open(QIODevice::ReadOnly) && manifest.size() <= 1024 * 1024) {
+		const auto data = manifest.readAll();
+		if (auto route = ParseTeamBaseRoute(data, user)) {
+			QDir().mkpath(QFileInfo(cachePath).absolutePath());
+			QSaveFile cache(cachePath);
+			if (!cache.open(QIODevice::WriteOnly)
+				|| cache.write(data) != data.size() || !cache.commit()) {
+				return TeamBaseRoute{};
+			}
+			return route;
+		}
+	}
+	if (QFile::exists(cachePath)) {
+		QFile cache(cachePath);
+		if (cache.open(QIODevice::ReadOnly) && cache.size() <= 1024 * 1024) {
+			if (auto route = ParseTeamBaseRoute(cache.readAll(), user)) {
+				return route;
+			}
+		}
+		return TeamBaseRoute{};
+	}
+	return std::nullopt;
+}
+
+}

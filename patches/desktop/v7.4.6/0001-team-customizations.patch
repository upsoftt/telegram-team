+// Выгрузка участников группы: список участников (если он не скрыт), вся
+// история чата (кто писал, кто вступал и выходил) и итог в файл. Файл
+// .tsv — для утилит, .xlsx — таблица Excel для человека.
+void RunMembersExport(
+		not_null<Window::SessionController*> controller,
+		not_null<ChannelData*> channel,
+		const QString &out,
+		bool openWhenDone,
+		ExportOptions options) {
+	controller->window().showToast(u"Выгружаю участников и историю чата "
+		"\"%1\". Со сбором по реакциям и опросам это займёт несколько "
+		"минут."_q.arg(channel->name()));
+	const auto weak = base::make_weak(controller);
+	const auto account = channel->session().userId();
+	const auto toast = [=](const QString &text) {
+		if (const auto strong = weak.get()) {
+			strong->window().showToast(text, crl::time(10000));
+		}
+	};
+	LoadAllMembers(channel, [=](std::shared_ptr<MembersLoad> members) {
+		auto history = std::make_shared<HistoryScan>(HistoryScan{
+			.session = &channel->session(),
+			.channel = channel,
+		});
+		history->done = [=](std::shared_ptr<HistoryScan> history) {
+			CollectEngagement(channel, *history, options, [=](std::shared_ptr<Engagement> extra) {
+				const auto rows = BuildMemberRows(channel, *members, *history, *extra, options);
+				const auto error = out.endsWith(u".xlsx"_q, Qt::CaseInsensitive)
+					? WriteMembersXlsx(rows, peerToChannel(channel->id), account, out)
+					: WriteMembersTsv(rows, out);
+				const auto inChat = ranges::count_if(rows, [](const MemberRow &r) {
+					return r.role != u"вышел"_q;
+				});
+				const auto silent = ranges::count_if(rows, [](const MemberRow &r) {
+					return r.role == u"реакция"_q
+						|| r.role == u"опрос"_q
+						|| r.role == u"упоминание"_q;
+				});
+				const auto problems = QStringList{
+					members->error.isEmpty()
+						? QString()
+						: u"участники: %1"_q.arg(members->error),
+					history->error.isEmpty()
+						? QString()
+						: u"история: %1"_q.arg(history->error),
+					error,
+				}.filter(QRegularExpression(u"."_q));
+				toast(u"В файле %1 человек: в чате %2 из %3, по реакциям и "
+					"опросам %4, сообщений %5. Файл: %6%7"_q
+					.arg(rows.size())
+					.arg(inChat)
+					.arg(channel->membersCount())
+					.arg(silent)
+					.arg(history->messages)
+					.arg(QDir::toNativeSeparators(out))
+					.arg(problems.isEmpty()
+						? QString()
+						: (u". Ошибки: "_q + problems.join(u"; "_q))));
+				if (openWhenDone && error.isEmpty()) {
+					QDesktopServices::openUrl(QUrl::fromLocalFile(out));
+				}
+			});
+		};
+		ScanHistoryPage(history);
+	});
+}

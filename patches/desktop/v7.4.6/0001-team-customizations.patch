+[[nodiscard]] QString WriteMembersXlsx(
+		const std::vector<MemberRow> &rows,
+		ChannelId channelId,
+		UserId account,
+		const QString &path) {
+	struct Column {
+		QString title;
+		int width = 0;
+		Fn<QString(const MemberRow&)> text;
+		Fn<QString(const MemberRow&)> link;
+		bool number = false;
+	};
+	const auto yes = [](bool value) {
+		return value ? u"да"_q : QString();
+	};
+	const auto columns = std::vector<Column>{
+		{ u"Имя"_q, 22, [](const MemberRow &r) { return r.firstName; } },
+		{ u"Фамилия"_q, 18, [](const MemberRow &r) { return r.lastName; } },
+		{ u"Написать"_q, 11, [=](const MemberRow &r) {
+			return WriteLinkFor(r, channelId, account).isEmpty()
+				? QString()
+				: u"написать"_q;
+		}, [=](const MemberRow &r) {
+			return WriteLinkFor(r, channelId, account);
+		} },
+		{ u"Ник"_q, 18, [](const MemberRow &r) {
+			return r.username.isEmpty() ? QString() : (u"@"_q + r.username);
+		}, [](const MemberRow &r) {
+			return r.username.isEmpty()
+				? QString()
+				: (u"https://t.me/"_q + r.username);
+		} },
+		{ u"В чате"_q, 12, [](const MemberRow &r) { return r.role; } },
+		{ u"Сообщений"_q, 11, [](const MemberRow &r) {
+			return r.count ? QString::number(r.count) : QString();
+		}, nullptr, true },
+		{ u"Последнее сообщение"_q, 17, [](const MemberRow &r) {
+			return TsvDate(r.last);
+		}, [=](const MemberRow &r) {
+			return r.lastId
+				? u"tg://privatepost?channel=%1&post=%2"_q
+					.arg(channelId.bare)
+					.arg(r.lastId.bare)
+				: QString();
+		} },
+		{ u"Что писал последним"_q, 60, [](const MemberRow &r) {
+			return r.lastText;
+		} },
+		{ u"Первое сообщение"_q, 17, [](const MemberRow &r) {
+			return TsvDate(r.first);
+		} },
+		{ u"Вступил"_q, 17, [](const MemberRow &r) {
+			return TsvDate(r.joined);
+		} },
+		{ u"Вышел"_q, 17, [](const MemberRow &r) {
+			return (r.role == u"вышел"_q) ? TsvDate(r.left) : QString();
+		} },
+		{ u"Был в сети"_q, 15, [](const MemberRow &r) { return r.lastseen; } },
+		{ u"Премиум"_q, 9, [=](const MemberRow &r) { return yes(r.premium); } },
+		{ u"Пишут только с премиумом"_q, 12, [=](const MemberRow &r) {
+			return yes(r.premiumToWrite);
+		} },
+		{ u"Бот"_q, 6, [=](const MemberRow &r) { return yes(r.bot); } },
+		{ u"Удалён"_q, 8, [=](const MemberRow &r) { return yes(r.deleted); } },
+		{ u"Телефон"_q, 15, [](const MemberRow &r) { return r.phone; } },
+		{ u"Номер в Telegram"_q, 14, [](const MemberRow &r) {
+			return QString::number(r.id.bare);
+		}, nullptr, true },
+	};
+	const auto lastColumn = XlsxColumn(int(columns.size()) - 1);
+	const auto lastRow = int(rows.size()) + 1;
+
+	auto sheet = QString();
+	auto links = QString();
+	auto rels = QString();
+	auto linkIndex = 0;
+	sheet += u"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
+		"<worksheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" "
+		"xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">"
+		"<sheetViews><sheetView workbookViewId=\"0\">"
+		"<pane xSplit=\"2\" ySplit=\"1\" topLeftCell=\"C2\" activePane=\"bottomRight\" state=\"frozen\"/>"
+		"</sheetView></sheetViews><cols>"_q;
+	for (auto i = 0; i != int(columns.size()); ++i) {
+		sheet += u"<col min=\"%1\" max=\"%1\" width=\"%2\" customWidth=\"1\"/>"_q
+			.arg(i + 1)
+			.arg(columns[i].width);
+	}
+	sheet += u"</cols><sheetData><row r=\"1\">"_q;
+	for (auto i = 0; i != int(columns.size()); ++i) {
+		sheet += u"<c r=\"%1\" t=\"inlineStr\" s=\"1\"><is><t>%2</t></is></c>"_q
+			.arg(XlsxColumn(i) + u"1"_q, XmlText(columns[i].title));
+	}
+	sheet += u"</row>"_q;
+	for (auto r = 0; r != int(rows.size()); ++r) {
+		const auto &row = rows[r];
+		const auto rowNumber = r + 2;
+		sheet += u"<row r=\"%1\">"_q.arg(rowNumber);
+		for (auto i = 0; i != int(columns.size()); ++i) {
+			const auto &column = columns[i];
+			const auto text = column.text(row);
+			if (text.isEmpty()) {
+				continue;
+			}
+			const auto cell = XlsxColumn(i) + QString::number(rowNumber);
+			const auto link = column.link ? column.link(row) : QString();
+			const auto style = link.isEmpty() ? QString() : u" s=\"2\""_q;
+			if (column.number) {
+				sheet += u"<c r=\"%1\"%2><v>%3</v></c>"_q.arg(cell, style, text);
+			} else {
+				sheet += u"<c r=\"%1\" t=\"inlineStr\"%2><is><t xml:space=\"preserve\">%3</t></is></c>"_q
+					.arg(cell, style, XmlText(text));
+			}
+			if (!link.isEmpty()) {
+				const auto id = u"rId%1"_q.arg(++linkIndex);
+				links += u"<hyperlink ref=\"%1\" r:id=\"%2\"/>"_q.arg(cell, id);
+				rels += u"<Relationship Id=\"%1\" "
+					"Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/hyperlink\" "
+					"Target=\"%2\" TargetMode=\"External\"/>"_q
+					.arg(id, XmlText(link));
+			}
+		}
+		sheet += u"</row>"_q;
+	}
+	sheet += u"</sheetData><autoFilter ref=\"A1:%1%2\"/>"_q
+		.arg(lastColumn)
+		.arg(lastRow);
+	if (!links.isEmpty()) {
+		sheet += u"<hyperlinks>"_q + links + u"</hyperlinks>"_q;
+	}
+	sheet += u"</worksheet>"_q;
+
+	const auto types = u"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
+		"<Types xmlns=\"http://schemas.openxmlformats.org/package/2006/content-types\">"
+		"<Default Extension=\"rels\" ContentType=\"application/vnd.openxmlformats-package.relationships+xml\"/>"
+		"<Default Extension=\"xml\" ContentType=\"application/xml\"/>"
+		"<Override PartName=\"/xl/workbook.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml\"/>"
+		"<Override PartName=\"/xl/worksheets/sheet1.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml\"/>"
+		"<Override PartName=\"/xl/styles.xml\" ContentType=\"application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml\"/>"
+		"</Types>"_q;
+	const auto rootRels = u"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
+		"<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">"
+		"<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument\" Target=\"xl/workbook.xml\"/>"
+		"</Relationships>"_q;
+	const auto workbook = u"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
+		"<workbook xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\" "
+		"xmlns:r=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships\">"
+		"<sheets><sheet name=\"Участники\" sheetId=\"1\" r:id=\"rId1\"/></sheets>"
+		"<definedNames><definedName name=\"_xlnm._FilterDatabase\" localSheetId=\"0\" hidden=\"1\">"
+		"'Участники'!$A$1:$%1$%2</definedName></definedNames>"
+		"</workbook>"_q.arg(lastColumn).arg(lastRow);
+	const auto workbookRels = u"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
+		"<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">"
+		"<Relationship Id=\"rId1\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet\" Target=\"worksheets/sheet1.xml\"/>"
+		"<Relationship Id=\"rId2\" Type=\"http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles\" Target=\"styles.xml\"/>"
+		"</Relationships>"_q;
+	const auto styles = u"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
+		"<styleSheet xmlns=\"http://schemas.openxmlformats.org/spreadsheetml/2006/main\">"
+		"<fonts count=\"3\">"
+		"<font><sz val=\"11\"/><name val=\"Calibri\"/></font>"
+		"<font><b/><sz val=\"11\"/><name val=\"Calibri\"/></font>"
+		"<font><u/><sz val=\"11\"/><color rgb=\"FF0563C1\"/><name val=\"Calibri\"/></font>"
+		"</fonts>"
+		"<fills count=\"3\">"
+		"<fill><patternFill patternType=\"none\"/></fill>"
+		"<fill><patternFill patternType=\"gray125\"/></fill>"
+		"<fill><patternFill patternType=\"solid\"><fgColor rgb=\"FFDDEBF7\"/><bgColor indexed=\"64\"/></patternFill></fill>"
+		"</fills>"
+		"<borders count=\"1\"><border><left/><right/><top/><bottom/><diagonal/></border></borders>"
+		"<cellStyleXfs count=\"1\"><xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\"/></cellStyleXfs>"
+		"<cellXfs count=\"3\">"
+		"<xf numFmtId=\"0\" fontId=\"0\" fillId=\"0\" borderId=\"0\" xfId=\"0\"/>"
+		"<xf numFmtId=\"0\" fontId=\"1\" fillId=\"2\" borderId=\"0\" xfId=\"0\" applyFont=\"1\" applyFill=\"1\" applyAlignment=\"1\"><alignment wrapText=\"1\" vertical=\"center\"/></xf>"
+		"<xf numFmtId=\"0\" fontId=\"2\" fillId=\"0\" borderId=\"0\" xfId=\"0\" applyFont=\"1\"/>"
+		"</cellXfs>"
+		"<cellStyles count=\"1\"><cellStyle name=\"Normal\" xfId=\"0\" builtinId=\"0\"/></cellStyles>"
+		"</styleSheet>"_q;
+	const auto sheetRels = u"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
+		"<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">"_q
+		+ rels
+		+ u"</Relationships>"_q;
+
+	auto zip = XlsxZip(path);
+	const auto ok = zip.add("[Content_Types].xml", types.toUtf8())
+		&& zip.add("_rels/.rels", rootRels.toUtf8())
+		&& zip.add("xl/workbook.xml", workbook.toUtf8())
+		&& zip.add("xl/_rels/workbook.xml.rels", workbookRels.toUtf8())
+		&& zip.add("xl/styles.xml", styles.toUtf8())
+		&& zip.add("xl/worksheets/sheet1.xml", sheet.toUtf8())
+		&& zip.add("xl/worksheets/_rels/sheet1.xml.rels", sheetRels.toUtf8())
+		&& zip.finish();
+	return ok ? QString() : u"не удалось записать файл %1"_q.arg(path);
+}

+[[nodiscard]] QString XmlText(const QString &text) {
+	auto result = QString();
+	result.reserve(text.size());
+	for (const auto ch : text) {
+		const auto code = ch.unicode();
+		if (code < 0x20 && code != '\t' && code != '\n' && code != '\r') {
+			continue;
+		} else if (code == 0xFFFE || code == 0xFFFF) {
+			continue;
+		}
+		switch (code) {
+		case '&': result += u"&amp;"_q; break;
+		case '<': result += u"&lt;"_q; break;
+		case '>': result += u"&gt;"_q; break;
+		case '"': result += u"&quot;"_q; break;
+		default: result += ch;
+		}
+	}
+	return result;
+}
+
+[[nodiscard]] QString XlsxColumn(int index) {
+	auto result = QString();
+	for (auto i = index + 1; i > 0; i = (i - 1) / 26) {
+		result.prepend(QChar('A' + ((i - 1) % 26)));
+	}
+	return result;
+}

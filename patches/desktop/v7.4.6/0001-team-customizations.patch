+struct HistoryScan {
+	not_null<Main::Session*> session;
+	not_null<ChannelData*> channel;
+	base::flat_map<UserId, AuthorStats> authors;
+	// Сообщения с реакциями и опросы: по ним потом спрашиваются те, кто
+	// поставил реакцию или проголосовал, — молчащих иначе не видно.
+	std::vector<MsgId> reactMsgs;
+	std::vector<MsgId> pollMsgs;
+	// Упомянутые по имени: @человек, который сам не писал, попадает сюда.
+	base::flat_set<UserId> mentioned;
+	MsgId offsetId = 0;
+	int messages = 0;
+	QString error;
+	Fn<void(std::shared_ptr<HistoryScan>)> done;

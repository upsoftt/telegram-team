+// LeadSearcher: участники группы целиком, страницами по 200. Большинство
+// участников ни разу не писали, и открыть с ними чат можно только после
+// того, как сервер прислал их вместе с ключом доступа (access hash).
+struct MembersLoad {
+	not_null<Main::Session*> session;
+	not_null<ChannelData*> channel;
+	std::vector<Api::ChatParticipant> list;
+	base::flat_set<UserId> seen;
+	int total = 0;
+	int offset = 0;
+	QString error;
+	Fn<void(std::shared_ptr<MembersLoad>)> done;
+};
+
+// Пауза между страницами: подряд без неё сервер отвечает FLOOD_WAIT.
+constexpr auto kMembersPagePause = crl::time(400);
+
+[[nodiscard]] int FloodWaitSeconds(const MTP::Error &error) {
+	const auto type = error.type();
+	const auto prefix = u"FLOOD_WAIT_"_q;
+	return type.startsWith(prefix) ? type.mid(prefix.size()).toInt() : 0;
+}
+
+void LoadMembersPage(std::shared_ptr<MembersLoad> state) {
+	const auto session = state->session;
+	const auto channel = state->channel;
+	session->api().request(MTPchannels_GetParticipants(
+		channel->inputChannel(),
+		MTP_channelParticipantsRecent(),
+		MTP_int(state->offset),
+		MTP_int(200),
+		MTP_long(0)
+	)).done([=](const MTPchannels_ChannelParticipants &result) {
+		auto received = 0;
+		result.match([&](const MTPDchannels_channelParticipants &data) {
+			session->data().processUsers(data.vusers());
+			session->data().processChats(data.vchats());
+			state->total = data.vcount().v;
+			for (const auto &p : data.vparticipants().v) {
+				auto participant = Api::ChatParticipant(p, channel);
+				++received;
+				if (participant.isUser()
+					&& !state->seen.contains(participant.userId())) {
+					state->seen.emplace(participant.userId());
+					state->list.push_back(std::move(participant));
+				}
+			}
+		}, [](const MTPDchannels_channelParticipantsNotModified &) {
+		});
+		state->offset += received;
+		if (!received || state->offset >= state->total) {
+			base::take(state->done)(state);
+			return;
+		}
+		base::call_delayed(kMembersPagePause, session.get(), [=] {
+			LoadMembersPage(state);
+		});
+	}).fail([=](const MTP::Error &error) {
+		if (const auto seconds = FloodWaitSeconds(error)) {
+			base::call_delayed(crl::time(seconds + 1) * 1000, session.get(), [=] {
+				LoadMembersPage(state);
+			});
+			return;
+		}
+		state->error = error.type();
+		base::take(state->done)(state);
+	}).send();
+}
+
+void LoadAllMembers(
+		not_null<ChannelData*> channel,
+		Fn<void(std::shared_ptr<MembersLoad>)> done) {
+	auto state = std::make_shared<MembersLoad>(MembersLoad{
+		.session = &channel->session(),
+		.channel = channel,
+		.done = std::move(done),
+	});
+	LoadMembersPage(std::move(state));
+}

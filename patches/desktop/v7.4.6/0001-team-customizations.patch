+Main::Account *Application::accountByUserId(uint64 userId) const {
+	if (!userId || !_domain->started()) {
+		return nullptr;
+	}
+	for (const auto &withIndex : _domain->accounts()) {
+		const auto account = withIndex.account.get();
+		if (const auto session = account->maybeSession()) {
+			if (session->userId().bare == userId) {
+				return account;
+			}
+		}
+	}
+	return nullptr;
+}
+
+Main::Account *Application::accountByName(const QString &name) const {
+	auto found = (Main::Account*)nullptr;
+	for (const auto &withIndex : _domain->accounts()) {
+		const auto account = withIndex.account.get();
+		const auto session = account->maybeSession();
+		if (!session) {
+			continue;
+		}
+		const auto user = session->user();
+		const auto wanted = name.startsWith(QChar('@')) ? name.mid(1) : name;
+		const auto same = !user->name().compare(wanted, Qt::CaseInsensitive)
+			|| !user->firstName.compare(wanted, Qt::CaseInsensitive)
+			|| (!user->username().isEmpty()
+				&& !user->username().compare(wanted, Qt::CaseInsensitive));
+		if (!same) {
+			continue;
+		} else if (found) {
+			// Два аккаунта с одним именем: угадывать нельзя.
+			return nullptr;
+		}
+		found = account;
+	}
+	return found;
+}

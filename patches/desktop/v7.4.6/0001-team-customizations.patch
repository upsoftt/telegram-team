+// LeadSearcher: черновик письма из параметров text64 или text.
+// [слова](адрес) — ссылка на адрес, [слова] без адреса — на defaultUrl, а без
+// него остаются просто словами.
+[[nodiscard]] TextWithEntities LinkDraftFromParams(
+		const QMap<QString, QString> &params,
+		const QString &defaultUrl) {
+	static const auto kLink = QRegularExpression(
+		u"\\[([^\\]\\n]+)\\](?:\\((https?://[^)\\s]+)\\))?"_q);
+	// text64 — тот же черновик в base64url от UTF-8. Кириллица в обычном
+	// параметре стоит 6 знаков на букву, и письмо целиком упиралось в предел
+	// длины ссылки около 8 200 знаков: Windows её молча не передавала.
+	const auto source = params.contains(u"text64"_q)
+		? QString::fromUtf8(QByteArray::fromBase64(
+			params.value(u"text64"_q).toLatin1(),
+			QByteArray::Base64UrlEncoding | QByteArray::OmitTrailingEquals))
+		: params.value(u"text"_q);
+	auto draft = TextWithEntities();
+	auto last = 0;
+	auto it = kLink.globalMatch(source);
+	while (it.hasNext()) {
+		const auto m = it.next();
+		draft.text += source.mid(last, m.capturedStart() - last);
+		const auto words = m.captured(1);
+		const auto href = m.captured(2).isEmpty() ? defaultUrl : m.captured(2);
+		if (!href.isEmpty()) {
+			draft.entities.push_back(EntityInText(
+				EntityType::CustomUrl,
+				int(draft.text.size()),
+				int(words.size()),
+				href));
+		}
+		draft.text += words;
+		last = m.capturedEnd();
+	}
+	draft.text += source.mid(last);
+	return draft;
+}

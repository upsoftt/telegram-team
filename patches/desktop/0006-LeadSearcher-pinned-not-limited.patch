From 62b99369797b23b4b8901824d89735d39d8ddb26 Mon Sep 17 00:00:00 2001
From: upsoft <13884634+upsoftt@users.noreply.github.com>
Date: Mon, 24 Aug 2026 03:29:43 +0300
Subject: [PATCH 06/12] LeadSearcher: pinned chats not limited by subscription
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Клиент больше не выбирает предел закреплений по подписке, а всегда берёт
больший — для основного списка, папок, архива и «Избранного». Окончательный
предел всё равно ставит сервер: правка снимает только клиентскую заслонку,
из-за которой кнопка «Закрепить» гаснет раньше времени.
---
 .../SourceFiles/data/data_premium_limits.cpp   | 18 ++++++------------
 1 file changed, 6 insertions(+), 12 deletions(-)

diff --git a/Telegram/SourceFiles/data/data_premium_limits.cpp b/Telegram/SourceFiles/data/data_premium_limits.cpp
index cb1fe7eada..08590bdba6 100644
--- a/Telegram/SourceFiles/data/data_premium_limits.cpp
+++ b/Telegram/SourceFiles/data/data_premium_limits.cpp
@@ -95,9 +95,9 @@ int PremiumLimits::dialogFiltersChatsPremium() const {
 	return appConfigLimit("dialog_filters_chats_limit_premium", 200);
 }
 int PremiumLimits::dialogFiltersChatsCurrent() const {
-	return isPremium()
-		? dialogFiltersChatsPremium()
-		: dialogFiltersChatsDefault();
+	// Клиент не режет закрепления по подписке: предел ставит сервер, и
+	// упираться в него должен запрос, а не серая кнопка в интерфейсе.
+	return dialogFiltersChatsPremium();
 }
 
 int PremiumLimits::dialogFiltersLinksDefault() const {
@@ -119,9 +119,7 @@ int PremiumLimits::dialogsPinnedPremium() const {
 	return appConfigLimit("dialogs_pinned_limit_premium", 10);
 }
 int PremiumLimits::dialogsPinnedCurrent() const {
-	return isPremium()
-		? dialogsPinnedPremium()
-		: dialogsPinnedDefault();
+	return dialogsPinnedPremium();
 }
 
 int PremiumLimits::dialogsFolderPinnedDefault() const {
@@ -131,9 +129,7 @@ int PremiumLimits::dialogsFolderPinnedPremium() const {
 	return appConfigLimit("dialogs_folder_pinned_limit_premium", 200);
 }
 int PremiumLimits::dialogsFolderPinnedCurrent() const {
-	return isPremium()
-		? dialogsFolderPinnedPremium()
-		: dialogsFolderPinnedDefault();
+	return dialogsFolderPinnedPremium();
 }
 
 int PremiumLimits::topicsPinnedCurrent() const {
@@ -147,9 +143,7 @@ int PremiumLimits::savedSublistsPinnedPremium() const {
 	return appConfigLimit("saved_dialogs_pinned_limit_premium", 100);
 }
 int PremiumLimits::savedSublistsPinnedCurrent() const {
-	return isPremium()
-		? savedSublistsPinnedPremium()
-		: savedSublistsPinnedDefault();
+	return savedSublistsPinnedPremium();
 }
 
 int PremiumLimits::channelsPublicDefault() const {

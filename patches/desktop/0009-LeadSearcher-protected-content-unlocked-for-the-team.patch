+bool PeerData::protectedContentUnlocked() const {
+#ifdef TGTEAM_UNLOCK_PROTECTED
+	// The team build: our own team saves and forwards posts of any
+	// protected channel or group, admins or not. The publicly distributed
+	// build is configured without this and unlocks only for admins.
+	if (isChannel() || isChat()) {
+		return true;
+	}
+#endif // TGTEAM_UNLOCK_PROTECTED
+	if (const auto channel = asChannel()) {
+		return channel->amCreator() || channel->hasAdminRights();
+	} else if (const auto chat = asChat()) {
+		return chat->amCreator() || chat->hasAdminRights();
+	}
+	return false;
+}

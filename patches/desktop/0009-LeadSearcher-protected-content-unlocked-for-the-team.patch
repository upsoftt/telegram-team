+namespace Api {
+namespace {
+
+constexpr auto kCheckInterval = crl::time(300);
+// A prepared file shows up in the chat once it is read and has a thumbnail.
+constexpr auto kAppearTimeout = crl::time(60 * 1000);
+// Uploading a big video can take long, but a stuck send must not hold the
+// rest of the copies forever.
+constexpr auto kSendTimeout = crl::time(30 * 60 * 1000);
+// A download is given up only when it stops moving, not by its length.
+constexpr auto kStallTimeout = crl::time(5 * 60 * 1000);
+// Uploads read the files lazily, so copies are kept for a day and removed
+// on the next copy after that.
+constexpr auto kKeepCopiesSeconds = 24 * 60 * 60;
+constexpr auto kPreviewWidth = 308;
+
+enum class PartKind {
+	Text,
+	Photo,
+	Video,
+	File,
+	Voice,
+	Round,
+	Sticker,
+	Unsupported,
+};
+
+enum class Sent {
+	Nothing,
+	Request, // A plain request, it keeps its place among other requests.
+	Upload, // Goes through the uploader, later requests can overtake it.
+};
+
+struct Part {
+	FullMsgId itemId;
+	PartKind kind = PartKind::Text;
+	TextWithTags text;
+	bool spoiler = false;
+	PhotoData *photo = nullptr;
+	DocumentData *document = nullptr;
+	std::shared_ptr<Data::PhotoMedia> photoMedia;
+	std::shared_ptr<Data::DocumentMedia> documentMedia;
+	QString path;
+	bool ready = false;
+	bool failed = false;
+};
+
+struct Unit {
+	std::vector<Part> parts;
+};
+
+[[nodiscard]] QString Phrase(const QString &ru, const QString &en) {
+	return Lang::GetInstance().id().startsWith(u"ru"_q) ? ru : en;
+}
+
+void ShowToast(const QString &text) {
+	if (const auto window = Core::App().activeWindow()) {
+		window->showToast(text);
+	}
+}
+
+[[nodiscard]] QString CopiesRoot() {
+	return QDir::tempPath() + u"/TelegramTeam/copies"_q;
+}
+
+void RemoveOldCopies() {
+	const auto root = CopiesRoot();
+	const auto border = QDateTime::currentDateTime().addSecs(
+		-kKeepCopiesSeconds);
+	auto dirs = QDir(root).entryInfoList(QDir::Dirs | QDir::NoDotAndDotDot);
+	for (const auto &info : dirs) {
+		if (info.lastModified() < border) {
+			QDir(info.absoluteFilePath()).removeRecursively();
+		}
+	}
+}
+
+[[nodiscard]] QString SafeFileName(QString name) {
+	static const auto bad = QString(u"\\/:*?\"<>|"_q);
+	for (auto &ch : name) {
+		if (bad.contains(ch) || ch.unicode() < 32) {
+			ch = QChar('_');
+		}
+	}
+	return name.trimmed();
+}
+
+// Each file gets its own folder, so the recipient sees the original name
+// and two files with one name never collide.
+[[nodiscard]] QString MakeCopyPath(const QString &name) {
+	const auto folder = CopiesRoot()
+		+ '/'
+		+ QString::number(base::RandomValue<uint64>(), 16);
+	QDir().mkpath(folder);
+	return folder + '/' + name;
+}
+
+[[nodiscard]] QString DocumentCopyName(
+		not_null<DocumentData*> document,
+		PartKind kind) {
+	const auto name = SafeFileName(document->filename());
+	if (!name.isEmpty()) {
+		return name;
+	}
+	auto suffix = QMimeDatabase().mimeTypeForName(
+		document->mimeString()).preferredSuffix();
+	if (suffix.isEmpty()) {
+		suffix = (kind == PartKind::Voice)
+			? u"ogg"_q
+			: (kind == PartKind::Video || kind == PartKind::Round)
+			? u"mp4"_q
+			: u"bin"_q;
+	}
+	const auto base = (kind == PartKind::Voice)
+		? u"voice"_q
+		: (kind == PartKind::Round)
+		? u"round"_q
+		: (kind == PartKind::Video)
+		? u"video"_q
+		: u"file"_q;
+	return base + '.' + suffix;
+}
+
+[[nodiscard]] Part MakePart(not_null<HistoryItem*> item, bool dropCaptions) {
+	auto result = Part{ .itemId = item->fullId() };
+	const auto media = item->media();
+	const auto &original = item->originalText();
+	if (!(dropCaptions && media && !media->webpage())) {
+		result.text = TextWithTags{
+			original.text,
+			TextUtilities::ConvertEntitiesToTextTags(original.entities),
+		};
+	}
+	if (!media || media->webpage()) {
+		result.kind = PartKind::Text;
+	} else if (const auto photo = media->photo()) {
+		result.kind = PartKind::Photo;
+		result.photo = photo;
+		result.spoiler = media->hasSpoiler();
+	} else if (const auto document = media->document()) {
+		result.document = document;
+		result.spoiler = media->hasSpoiler();
+		result.kind = document->sticker()
+			? PartKind::Sticker
+			: document->isVoiceMessage()
+			? PartKind::Voice
+			: document->isVideoMessage()
+			? PartKind::Round
+			: (document->isVideoFile() || document->isAnimation())
+			? PartKind::Video
+			: PartKind::File;
+	} else {
+		result.kind = PartKind::Unsupported;
+	}
+	return result;
+}
+
+[[nodiscard]] bool IsUploadKind(PartKind kind) {
+	return (kind == PartKind::Photo)
+		|| (kind == PartKind::Video)
+		|| (kind == PartKind::File);
+}
+
+[[nodiscard]] std::vector<Unit> CollectUnits(
+		std::vector<not_null<HistoryItem*>> items,
+		bool dropCaptions,
+		int captionLimit) {
+	const auto sameHistory = ranges::all_of(items, [&](auto item) {
+		return item->history() == items.front()->history();
+	});
+	if (sameHistory) {
+		ranges::stable_sort(items, ranges::less(), &HistoryItem::id);
+	}
+	auto result = std::vector<Unit>();
+	// Texts that can't stay a caption go right after their album.
+	auto pendingTexts = std::vector<Part>();
+	const auto flushTexts = [&] {
+		for (auto &text : pendingTexts) {
+			result.push_back({ .parts = { std::move(text) } });
+		}
+		pendingTexts.clear();
+	};
+	auto groupId = MessageGroupId();
+	for (const auto &item : items) {
+		auto part = MakePart(item, dropCaptions);
+		const auto group = item->groupId();
+		const auto joinsAlbum = group
+			&& (group == groupId)
+			&& IsUploadKind(part.kind)
+			&& !result.empty()
+			&& IsUploadKind(result.back().parts.back().kind);
+		if (!joinsAlbum) {
+			flushTexts();
+		}
+		groupId = group;
+		// Voice and round messages and stickers have no caption when they
+		// are sent again, and a caption over the limit would be refused.
+		const auto separateText = !part.text.text.isEmpty()
+			&& ((part.kind == PartKind::Voice
+				|| part.kind == PartKind::Round
+				|| part.kind == PartKind::Sticker)
+				|| (IsUploadKind(part.kind)
+					&& part.text.text.size() > captionLimit));
+		if (separateText) {
+			pendingTexts.push_back(Part{
+				.itemId = item->fullId(),
+				.kind = PartKind::Text,
+				.text = base::take(part.text),
+			});
+		}
+		if (joinsAlbum) {
+			result.back().parts.push_back(std::move(part));
+		} else {
+			result.push_back({ .parts = { std::move(part) } });
+		}
+	}
+	flushTexts();
+	return result;
+}
+
+// Starts saving a document to 'path', or joins a save already running:
+// a second save of the same document cancels the first one, and copies
+// into several chats at once download every document exactly once.
+[[nodiscard]] QString StartDocumentSave(
+		not_null<DocumentData*> document,
+		Data::FileOrigin origin,
+		PartKind kind) {
+	if (document->loading()) {
+		const auto already = document->loadingFilePath();
+		if (!already.isEmpty()) {
+			return already;
+		}
+	} else {
+		const auto existing = document->filepath(true);
+		if (!existing.isEmpty()) {
+			return existing;
+		}
+	}
+	const auto path = MakeCopyPath(DocumentCopyName(document, kind));
+	document->save(origin, path);
+	return path;
+}
+
+class CopyJob final {
+public:
+	CopyJob(
+		uint64 id,
+		std::vector<not_null<HistoryItem*>> items,
+		SendAction action,
+		bool dropCaptions);
+
+	void start();
+
+private:
+	enum class State {
+		WaitReady,
+		WaitAppear,
+		WaitSent,
+		WaitUploadStart,
+		WaitUploadEnd,
+		Finished,
+	};
+
+	void tick();
+	void startLoading(Part &part);
+	void checkLoaded(Part &part);
+	[[nodiscard]] float64 currentProgress() const;
+	void sendNext();
+	[[nodiscard]] Sent sendUnit(Unit &unit);
+	[[nodiscard]] bool sendFiles(std::vector<Part*> parts);
+	void setState(State state);
+	void finish();
+
+	const uint64 _id = 0;
+	const not_null<Main::Session*> _session;
+	const not_null<History*> _history;
+	const bool _scheduled = false;
+	SendAction _action;
+	std::vector<Unit> _units;
+	base::Timer _timer;
+	State _state = State::WaitReady;
+	int _next = 0;
+	int _failed = 0;
+	crl::time _stateStarted = 0;
+	float64 _lastProgress = -1.;
+	crl::time _lastProgressAt = 0;
+	bool _addedSinceSend = false;
+	rpl::lifetime _lifetime;
+
+};
+
+std::vector<std::unique_ptr<CopyJob>> &Jobs() {
+	static auto result = std::vector<std::unique_ptr<CopyJob>>();
+	return result;
+}
+
+std::vector<uint64> &JobIds() {
+	static auto result = std::vector<uint64>();
+	return result;
+}
+
+void RemoveJob(uint64 id) {
+	auto &ids = JobIds();
+	const auto i = ranges::find(ids, id);
+	if (i != end(ids)) {
+		const auto index = int(i - begin(ids));
+		ids.erase(i);
+		Jobs().erase(begin(Jobs()) + index);
+	}
+}
+
+CopyJob::CopyJob(
+	uint64 id,
+	std::vector<not_null<HistoryItem*>> items,
+	SendAction action,
+	bool dropCaptions)
+: _id(id)
+, _session(&action.history->session())
+, _history(action.history)
+, _scheduled(action.options.scheduled || action.options.shortcutId)
+, _action(action)
+, _units(CollectUnits(
+	std::move(items),
+	dropCaptions,
+	Data::PremiumLimits(_session).captionLengthCurrent()))
+, _timer([=] { tick(); }) {
+	// A real forward ignores the replied message, and so do the copies:
+	// they stay in the right topic, but don't become replies.
+	_action.replyTo = FullReplyTo{
+		.topicRootId = action.replyTo.topicRootId,
+		.monoforumPeerId = action.replyTo.monoforumPeerId,
+	};
+	_action.clearDraft = false;
+	_session->data().newItemAdded(
+	) | rpl::filter([=](not_null<HistoryItem*> item) {
+		return (item->history() == _history)
+			&& item->out()
+			&& item->isSending();
+	}) | rpl::on_next([=] {
+		_addedSinceSend = true;
+	}, _lifetime);
+}
+
+void CopyJob::start() {
+	RemoveOldCopies();
+	auto withMedia = false;
+	for (auto &unit : _units) {
+		for (auto &part : unit.parts) {
+			startLoading(part);
+			withMedia = withMedia || IsUploadKind(part.kind)
+				|| part.kind == PartKind::Voice
+				|| part.kind == PartKind::Round;
+		}
+	}
+	if (withMedia) {
+		ShowToast(Phrase(
+			u"Канал защищён от копирования: отправляю копию. "
+			"Большие файлы сначала скачаются."_q,
+			u"The channel is protected: sending a copy. "
+			"Big files are downloaded first."_q));
+	}
+	_timer.callEach(kCheckInterval);
+	sendNext();
+}
+
+void CopyJob::startLoading(Part &part) {
+	const auto origin = Data::FileOrigin(part.itemId);
+	if (part.photo) {
+		part.photoMedia = part.photo->createMediaView();
+		part.photoMedia->wanted(Data::PhotoSize::Large, origin);
+	} else if (part.document
+		&& part.kind != PartKind::Sticker
+		&& part.kind != PartKind::Unsupported) {
+		// Keeps the bytes in memory while the copy is being made.
+		part.documentMedia = part.document->createMediaView();
+		part.path = StartDocumentSave(part.document, origin, part.kind);
+	} else {
+		part.ready = true;
+	}
+}
+
+void CopyJob::checkLoaded(Part &part) {
+	if (part.ready || part.failed) {
+		return;
+	} else if (part.photoMedia) {
+		// image() also finds a photo without the largest size, while
+		// loaded() waits for exactly that size and would wait forever.
+		const auto large = Data::PhotoSize::Large;
+		if (const auto image = part.photoMedia->image(large)) {
+			part.path = MakeCopyPath(u"photo.jpg"_q);
+			const auto bytes = part.photoMedia->imageBytes(large);
+			if (!bytes.isEmpty()) {
+				auto f = QFile(part.path);
+				if (f.open(QIODevice::WriteOnly)) {
+					f.write(bytes);
+					f.close();
+				}
+			} else {
+				image->original().save(part.path, "JPG", 95);
+			}
+			part.ready = (QFileInfo(part.path).size() > 0);
+			part.failed = !part.ready;
+		} else if (part.photo->failed(large)) {
+			part.failed = true;
+		}
+	} else if (part.document) {
+		if (part.document->loading()) {
+			return;
+		}
+		const auto info = QFileInfo(part.path);
+		const auto expected = part.document->size;
+		part.ready = info.exists()
+			&& (info.size() > 0)
+			&& (expected <= 0 || info.size() >= expected);
+		part.failed = !part.ready;
+	}
+}
+
+float64 CopyJob::currentProgress() const {
+	auto result = 0.;
+	if (_next < int(_units.size())) {
+		for (const auto &part : _units[_next].parts) {
+			if (part.document) {
+				result += part.document->progress();
+			} else if (part.photo) {
+				result += part.photo->progress();
+			}
+		}
+	}
+	return result;
+}
+
+void CopyJob::setState(State state) {
+	_state = state;
+	_stateStarted = crl::now();
+}
+
+void CopyJob::tick() {
+	const auto now = crl::now();
+	switch (_state) {
+	case State::WaitReady: {
+		const auto progress = currentProgress();
+		if (progress != _lastProgress) {
+			_lastProgress = progress;
+			_lastProgressAt = now;
+		} else if (now - _lastProgressAt >= kStallTimeout) {
+			for (auto &part : _units[_next].parts) {
+				if (!part.ready) {
+					part.failed = true;
+				}
+			}
+		}
+		sendNext();
+	} break;
+	case State::WaitAppear:
+		if (_addedSinceSend || (now - _stateStarted >= kAppearTimeout)) {
+			setState(State::WaitSent);
+		}
+		break;
+	case State::WaitSent:
+		if (!_history->latestSendingMessage()
+			|| (now - _stateStarted >= kSendTimeout)) {
+			sendNext();
+		}
+		break;
+	case State::WaitUploadStart:
+		// Scheduled messages don't appear in the chat, so the uploader
+		// itself tells when the file got its turn and when it is done.
+		if (_session->uploadsInProgress()) {
+			setState(State::WaitUploadEnd);
+		} else if (now - _stateStarted >= kAppearTimeout) {
+			sendNext();
+		}
+		break;
+	case State::WaitUploadEnd:
+		if (!_session->uploadsInProgress()
+			|| (now - _stateStarted >= kSendTimeout)) {
+			sendNext();
+		}
+		break;
+	case State::Finished:
+		break;
+	}
+}
+
+void CopyJob::sendNext() {
+	while (_next < int(_units.size())) {
+		auto &unit = _units[_next];
+		auto waiting = false;
+		for (auto &part : unit.parts) {
+			checkLoaded(part);
+			waiting = waiting || !(part.ready || part.failed);
+		}
+		if (waiting) {
+			if (_state != State::WaitReady) {
+				setState(State::WaitReady);
+				_lastProgress = currentProgress();
+				_lastProgressAt = crl::now();
+			}
+			return;
+		}
+		++_next;
+		_addedSinceSend = false;
+		const auto sent = sendUnit(unit);
+		if (sent == Sent::Nothing) {
+			continue;
+		} else if (!_scheduled) {
+			setState(State::WaitAppear);
+			return;
+		} else if (sent == Sent::Upload) {
+			setState(State::WaitUploadStart);
+			return;
+		}
+	}
+	finish();
+}
+
+Sent CopyJob::sendUnit(Unit &unit) {
+	auto &api = _session->api();
+	const auto &first = unit.parts.front();
+	switch (first.kind) {
+	case PartKind::Text:
+	case PartKind::Unsupported: {
+		if (first.kind == PartKind::Unsupported) {
+			++_failed;
+		}
+		if (first.text.text.isEmpty()) {
+			if (first.kind == PartKind::Text) {
+				++_failed;
+			}
+			return Sent::Nothing;
+		}
+		auto message = MessageToSend(_action);
+		message.textWithTags = first.text;
+		api.sendMessage(std::move(message));
+		return Sent::Request;
+	}
+	case PartKind::Sticker:
+		SendExistingDocument(MessageToSend(_action), first.document);
+		return Sent::Request;
+	case PartKind::Voice:
+	case PartKind::Round: {
+		if (first.failed) {
+			++_failed;
+			return Sent::Nothing;
+		}
+		auto f = QFile(first.path);
+		if (!f.open(QIODevice::ReadOnly)) {
+			++_failed;
+			return Sent::Nothing;
+		}
+		const auto bytes = f.readAll();
+		f.close();
+		const auto voice = (first.kind == PartKind::Voice)
+			? first.document->voice()
+			: first.document->round();
+		api.sendVoiceMessage(
+			bytes,
+			voice ? voice->waveform : VoiceWaveform(),
+			first.document->duration(),
+			(first.kind == PartKind::Round),
+			_action);
+		return Sent::Upload;
+	}
+	case PartKind::Photo:
+	case PartKind::Video:
+	case PartKind::File: {
+		auto parts = std::vector<Part*>();
+		for (auto &part : unit.parts) {
+			if (part.failed) {
+				++_failed;
+			} else {
+				parts.push_back(&part);
+			}
+		}
+		return (!parts.empty() && sendFiles(std::move(parts)))
+			? Sent::Upload
+			: Sent::Nothing;
+	}
+	}
+	return Sent::Nothing;
+}
+
+bool CopyJob::sendFiles(std::vector<Part*> parts) {
+	auto paths = QStringList();
+	for (const auto part : parts) {
+		paths.push_back(part->path);
+	}
+	auto list = Storage::PrepareMediaList(
+		paths,
+		kPreviewWidth,
+		_session->premium());
+	if (list.error != Ui::PreparedList::Error::None
+		|| list.files.size() != parts.size()) {
+		_failed += int(parts.size());
+		return false;
+	}
+	auto documents = false;
+	for (auto i = 0; i != int(parts.size()); ++i) {
+		auto &file = list.files[i];
+		file.caption = parts[i]->text;
+		file.spoiler = parts[i]->spoiler;
+		if (parts[i]->kind == PartKind::Photo) {
+			file.sendLargePhotos = true;
+		} else if (parts[i]->kind == PartKind::File) {
+			documents = true;
+		}
+	}
+	const auto album = (list.files.size() > 1)
+		? std::make_shared<SendingAlbum>()
+		: nullptr;
+	_session->api().sendFiles(
+		std::move(list),
+		documents ? SendMediaType::File : SendMediaType::Photo,
+		album,
+		_action);
+	return true;
+}
+
+void CopyJob::finish() {
+	if (_state == State::Finished) {
+		return;
+	}
+	setState(State::Finished);
+	_timer.cancel();
+	_lifetime.destroy();
+	if (_failed > 0) {
+		ShowToast(Phrase(
+			u"Не удалось скопировать сообщений: %1."_q,
+			u"Could not copy %1 message(s)."_q).arg(_failed));
+	}
+	const auto id = _id;
+	crl::on_main([=] {
+		RemoveJob(id);
+	});
+}
+
+} // namespace
+
+std::vector<not_null<HistoryItem*>> ExtractProtectedCopies(
+		std::vector<not_null<HistoryItem*>> &items) {
+	auto result = std::vector<not_null<HistoryItem*>>();
+	for (auto i = begin(items); i != end(items);) {
+		if ((*i)->needsProtectedCopy()) {
+			result.push_back(*i);
+			i = items.erase(i);
+		} else {
+			++i;
+		}
+	}
+	return result;
+}
+
+void SendProtectedCopies(
+		std::vector<not_null<HistoryItem*>> items,
+		SendAction action,
+		bool dropCaptions) {
+	if (items.empty()) {
+		return;
+	}
+	static auto NextId = uint64(0);
+	const auto id = ++NextId;
+	const auto session = &action.history->session();
+	Jobs().push_back(std::make_unique<CopyJob>(
+		id,
+		std::move(items),
+		action,
+		dropCaptions));
+	JobIds().push_back(id);
+	// A job must not outlive the account it sends from.
+	session->lifetime().add([=] {
+		RemoveJob(id);
+	});
+	Jobs().back()->start();
+}
+
+} // namespace Api

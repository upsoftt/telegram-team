За клиентом закрепляются tg:// и tonsite:// вдобавок к своей tgteam://:
раз владелец пользуется этой сборкой, ссылки из браузера должны попадать
в неё, а не поднимать закрытый личный клиент.

Регистрация обновляется на каждом запуске, а не только при смене версии:
личный Telegram записывает tg:// на себя при каждом своём обновлении и
молча забирал бы ссылки обратно.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 Telegram/SourceFiles/core/application.cpp | 49 +++++++++++------------
 1 file changed, 24 insertions(+), 25 deletions(-)

diff --git a/Telegram/SourceFiles/core/application.cpp b/Telegram/SourceFiles/core/application.cpp
index 7c5bb01bc3..fa615a124b 100644
--- a/Telegram/SourceFiles/core/application.cpp
+++ b/Telegram/SourceFiles/core/application.cpp
@@ -322,8 +322,12 @@ void Application::run() {
 
 	refreshGlobalProxy(); // Depends on app settings being read.
 
+	// LeadSearcher: личный Telegram забирает tg:// себе при каждом своём
+	// обновлении, поэтому схемы перерегистрируются на каждом запуске, а не
+	// только при смене версии, — иначе ссылки однажды молча уедут к нему.
+	autoRegisterUrlScheme();
+
 	if (const auto old = Local::oldSettingsVersion(); old < AppVersion) {
-		autoRegisterUrlScheme();
 		Platform::NewVersionLaunched(old);
 	}
 
@@ -2134,30 +2138,25 @@ void Application::RegisterUrlScheme() {
 		? u"-workdir \"%1\""_q.arg(cWorkingDir())
 		: QString();
 
-	// LeadSearcher: схемы tg:// и tonsite:// остаются за личным Telegram.
-	// Забрав их себе, эта сборка перехватывала бы вообще все ссылки системы,
-	// причём заново при каждом запуске.
-	base::Platform::RegisterUrlScheme(base::Platform::UrlSchemeDescriptor{
-		.executable = Platform::ExecutablePathForShortcuts(),
-		.arguments = arguments,
-		.protocol = u"tgteam"_q,
-		.protocolName = u"Telegram Team Link"_q,
-		.shortAppName = u"tdesktopteam"_q,
-		.longAppName = QCoreApplication::applicationName(),
-		.displayAppName = AppName.utf16(),
-		.displayAppDescription = AppName.utf16(),
-	});
-
-	base::Platform::RegisterUrlScheme(base::Platform::UrlSchemeDescriptor{
-		.executable = Platform::ExecutablePathForShortcuts(),
-		.arguments = arguments,
-		.protocol = u"ton"_q,
-		.protocolName = u"Ton Link"_q,
-		.shortAppName = u"tdesktop"_q,
-		.longAppName = QCoreApplication::applicationName(),
-		.displayAppName = AppName.utf16(),
-		.displayAppDescription = AppName.utf16(),
-	});
+	// LeadSearcher: обычные ссылки Telegram тоже открывает эта сборка —
+	// владелец пользуется ею, а не личным клиентом. Своя схема tgteam://
+	// остаётся: только в ней есть параметр account.
+	const auto scheme = [&](const QString &protocol, const QString &name) {
+		base::Platform::RegisterUrlScheme(base::Platform::UrlSchemeDescriptor{
+			.executable = Platform::ExecutablePathForShortcuts(),
+			.arguments = arguments,
+			.protocol = protocol,
+			.protocolName = name,
+			.shortAppName = u"tdesktopteam"_q,
+			.longAppName = QCoreApplication::applicationName(),
+			.displayAppName = AppName.utf16(),
+			.displayAppDescription = AppName.utf16(),
+		});
+	};
+	scheme(u"tgteam"_q, u"Telegram Team Link"_q);
+	scheme(u"tg"_q, u"Telegram Link"_q);
+	scheme(u"tonsite"_q, u"TonSite Link"_q);
+	scheme(u"ton"_q, u"Ton Link"_q);
 }
 
 bool IsAppLaunched() {

+Main::Account *Application::accountByUserId(uint64 userId) const {
+	if (!userId || !_domain->started()) {
+		return nullptr;
+	}
+	for (const auto &withIndex : _domain->accounts()) {
+		const auto account = withIndex.account.get();
+		if (const auto session = account->maybeSession()) {
+			if (session->userId().bare == userId) {
+				return account;
+			}
+		}
+	}
+	return nullptr;
+}
+
+bool Application::switchAccountForStartUrls() {
+	auto switched = false;
+	for (auto &url : cRefStartUrls()) {
+		if (url.scheme() != u"tgteam"_q) {
+			continue;
+		}
+		auto query = QUrlQuery(url.query());
+		const auto requested = query.queryItemValue(
+			u"account"_q).toULongLong();
+		query.removeAllQueryItems(u"account"_q);
+
+		// Дальше ссылку разбирают обычные обработчики, они знают только tg://.
+		url.setScheme(u"tg"_q);
+		url.setQuery(query);
+
+		if (!requested) {
+			continue;
+		}
+		const auto account = accountByUserId(requested);
+		if (!account) {
+			// Молча открыть чужим аккаунтом хуже, чем не переключиться:
+			// ответ ушёл бы не от того человека.
+			if (_lastActivePrimaryWindow) {
+				_lastActivePrimaryWindow->showToast(u"Аккаунт, который читает "
+					"этот чат, не подключён здесь. Открываю текущим."_q);
+			}
+			continue;
+		}
+		if (&_domain->active() != account) {
+			_domain->activate(account);
+			switched = true;
+		}
+	}
+	return switched;
+}
+
 void Application::checkStartUrls() {
 	if (_setupEmailLock.current()) {
+		// Ссылки остаются в очереди и разберутся, когда блокировка снимется:
+		// трогать их сейчас нельзя, иначе параметр account потеряется впустую.
+		return;
+	}
+	// Переключение аккаунта перестраивает окно, поэтому ссылка открывается
+	// следующим тиком — иначе она уходит в прежнюю сессию.
+	if (switchAccountForStartUrls()) {
+		InvokeQueued(this, [=] { checkStartUrls(); });
 		return;
 	}
 	if (!Core::App().passcodeLocked()) {
@@ -2074,23 +2134,15 @@ void Application::RegisterUrlScheme() {

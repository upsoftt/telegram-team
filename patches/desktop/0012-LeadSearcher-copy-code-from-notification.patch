+QString Manager::CopyableCode(
+		HistoryItem *item,
+		const DisplayOptions &options) {
+	constexpr auto kMaxCodeLength = 64;
+	if (!item || options.hideMessageText) {
+		return QString();
+	}
+	const auto peer = item->history()->peer;
+	if (item->forbidsForward() || !peer->allowsForwardingForMe()) {
+		return QString();
+	}
+	const auto &text = item->originalText();
+	for (const auto &entity : text.entities) {
+		const auto type = entity.type();
+		if ((type != EntityType::Code && type != EntityType::Pre)
+			|| !entity.validForText(text.text.size())) {
+			continue;
+		}
+		const auto code = text.text.mid(
+			entity.offset(),
+			entity.length()).trimmed();
+		if (!code.isEmpty()
+			&& code.size() <= kMaxCodeLength
+			&& !code.contains('\n')) {
+			return code;
+		}
+	}
+	if (options.spoilerLoginCode) {
+		// The same pattern that hides the login code under a spoiler.
+		static const auto LoginCode = QRegularExpression(
+			u"(?<![\\w\\-#])(\\d[\\d\\-]{3,6}\\d)(?!\\w\\-)"_q);
+		const auto match = LoginCode.match(text.text);
+		if (match.hasMatch()) {
+			return match.captured(1);
+		}
+	}
+	return QString();
+}
+
+QString Manager::CopyCodeActionText(
+		const QString &code,
+		const DisplayOptions &options,
+		bool withCopyWord) {
+	constexpr auto kShownCodeLength = 12;
+	const auto copy = tr::lng_group_invite_context_copy(tr::now);
+	if (options.spoilerLoginCode || code.size() > kShownCodeLength) {
+		return copy;
+	}
+	return withCopyWord ? (copy + ' ' + code) : code;
+}
+
+void Manager::CopyCodeToClipboard(const QString &code) {
+	if (!code.isEmpty()) {
+		QGuiApplication::clipboard()->setText(code);
+	}
+}

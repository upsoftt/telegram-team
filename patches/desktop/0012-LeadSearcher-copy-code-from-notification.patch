 void Notification::updateReplyGeometry() {
 	_reply->moveToRight(_replyPadding, height() - _reply->height() - _replyPadding);
+	if (_copy) {
+		// Both buttons must leave the userpic uncovered, otherwise the code
+		// wins: it is the reason to hover over such a notification.
+		const auto available = width()
+			- st::notifyPhotoPos.x()
+			- st::notifyPhotoSize
+			- 2 * _replyPadding;
+		_copyCrowdsReply = (_copy->width() + _replyPadding + _reply->width()
+			> available);
+		const auto right = showReplyAction()
+			? (_replyPadding + _reply->width() + _replyPadding)
+			: _replyPadding;
+		_copy->moveToRight(
+			right,
+			height() - _copy->height() - _replyPadding);
+	}
+}
+
+bool Notification::canCopyCode() const {
+	return _copy
+		&& !_copyCode.isEmpty()
+		&& (_item != nullptr)
+		&& !Core::App().passcodeLocked()
+		&& (Core::App().settings().notifyView()
+			<= Core::Settings::NotifyView::ShowPreview);
+}
+
+bool Notification::showReplyAction() const {
+	return canReply() && !(_copyCrowdsReply && canCopyCode());
+}
+
+bool Notification::canShowActions() const {
+	return canReply() || canCopyCode();
+}
+
+void Notification::copyCode() {
+	if (!canCopyCode()) {
+		return;
+	}
+	Manager::CopyCodeToClipboard(_copyCode);
+	unlinkHistoryInManager();
 }
 

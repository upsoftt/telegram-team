+				// share-ссылок t.me/user?text=, а сигналы приходят из
+				// обсуждений — там подставить ответ нужнее всего.
+				if (!draft.isEmpty()) {
+					Data::SetChatLinkDraft(peer, { draft }, draftReplyTo);
 				}
 				const auto id = SeparateId(peer);
 				const auto separate = (historyInNewWindow

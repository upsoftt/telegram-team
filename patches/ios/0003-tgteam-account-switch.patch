Параметр account в ссылке разбирался только на десктопе: на iPhone он молча
игнорировался, и чат открывался активным аккаунтом — а ради этого перехода
клиент на телефон и собирался.

Номер аккаунта вырезается из ссылки, по нему среди подключённых ищется нужный,
и дальше работает штатный openUrlWhenReady: он переключает аккаунт и ждёт, пока
контекст станет его, прежде чем открыть ссылку. Аккаунта нет на устройстве —
открываем текущим, как это делает десктоп.

Холодный старт по ссылке идёт мимо openUrl(url:), поэтому разбор добавлен и
в ветку launchOptions.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../TelegramUI/Sources/AppDelegate.swift      | 67 ++++++++++++++++++-
 1 file changed, 65 insertions(+), 2 deletions(-)

diff --git a/submodules/TelegramUI/Sources/AppDelegate.swift b/submodules/TelegramUI/Sources/AppDelegate.swift
index 91f1901c..3f27df58 100644
--- a/submodules/TelegramUI/Sources/AppDelegate.swift
+++ b/submodules/TelegramUI/Sources/AppDelegate.swift
@@ -1567,10 +1567,16 @@ private func extractAccountManagerState(records: AccountRecordsView<TelegramAcco
         })
         
         if let url = launchOptions?[.url] {
+            // TgTeam: холодный старт по ссылке идёт мимо openUrl(url:), поэтому
+            // номер аккаунта разбирается и здесь.
             if let url = url as? URL, url.scheme == "tg" || url.scheme == "ton" || url.scheme == buildConfig.appSpecificUrlScheme || WalletContext.isTonConnectUrl(url.absoluteString) {
-                self.openUrlWhenReady(url: url, external: true)
+                if !self.openUrlWithRequestedAccount(url: url, external: true) {
+                    self.openUrlWhenReady(url: url, external: true)
+                }
             } else if let urlString = url as? String, urlString.lowercased().hasPrefix("tg:") || urlString.lowercased().hasPrefix("ton:") || urlString.lowercased().hasPrefix("\(buildConfig.appSpecificUrlScheme):") || WalletContext.isTonConnectUrl(urlString), let url = URL(string: urlString) {
-                self.openUrlWhenReady(url: url, external: true)
+                if !self.openUrlWithRequestedAccount(url: url, external: true) {
+                    self.openUrlWhenReady(url: url, external: true)
+                }
             }
         }
         
@@ -2598,6 +2604,11 @@ private func extractAccountManagerState(records: AccountRecordsView<TelegramAcco
     }
 
     private func openUrl(url: URL) {
+        // TgTeam: ссылка с номером аккаунта уходит на отдельный путь — он
+        // сначала переключает аккаунт, а потом открывает её уже без параметра.
+        if self.openUrlWithRequestedAccount(url: url, external: true) {
+            return
+        }
         let _ = (self.sharedContextPromise.get()
         |> take(1)
         |> mapToSignal { sharedApplicationContext -> Signal<(SharedAccountContextImpl, AuthorizedApplicationContext?, UnauthorizedApplicationContext?), NoError> in
@@ -2963,6 +2974,58 @@ private func extractAccountManagerState(records: AccountRecordsView<TelegramAcco
         }))
     }
 
+    // TgTeam: ссылку с параметром account открывает тот аккаунт, который читает
+    // чат, а не текущий активный. Параметр наш, апстримный разбор ссылок его не
+    // знает, поэтому он вырезается — дальше ссылка идёт обычным путём.
+    private func tgteamRequestedAccount(url: URL) -> (userId: Int64, url: URL)? {
+        guard let components = URLComponents(url: url, resolvingAgainstBaseURL: false), let queryItems = components.queryItems else {
+            return nil
+        }
+        guard let value = queryItems.first(where: { $0.name == "account" })?.value, let userId = Int64(value), userId != 0 else {
+            return nil
+        }
+        var strippedComponents = components
+        let remainingItems = queryItems.filter { $0.name != "account" }
+        strippedComponents.queryItems = remainingItems.isEmpty ? nil : remainingItems
+        guard let strippedUrl = strippedComponents.url else {
+            return nil
+        }
+        return (userId, strippedUrl)
+    }
+
+    private func openUrlWithRequestedAccount(url: URL, external: Bool) -> Bool {
+        guard let request = self.tgteamRequestedAccount(url: url) else {
+            return false
+        }
+        let _ = (self.sharedContextPromise.get()
+        |> take(1)
+        |> mapToSignal { sharedApplicationContext -> Signal<AccountRecordId?, NoError> in
+            return sharedApplicationContext.sharedContext.activeAccountContexts
+            |> take(1)
+            |> map { _, contexts, _ -> AccountRecordId? in
+                for (_, context, _) in contexts {
+                    if context.account.peerId.id._internalGetInt64Value() == request.userId {
+                        return context.account.id
+                    }
+                }
+                return nil
+            }
+        }
+        |> deliverOnMainQueue).start(next: { [weak self] accountId in
+            guard let strongSelf = self else {
+                return
+            }
+            if let accountId = accountId {
+                strongSelf.openUrlWhenReady(accountId: accountId, url: request.url, external: external)
+            } else {
+                // Нужный аккаунт на этом устройстве не подключён. Открываем
+                // текущим: совсем не открыть хуже, и десктоп поступает так же.
+                strongSelf.openUrl(url: request.url)
+            }
+        })
+        return true
+    }
+
     private var openUrlInProgress: URL?
     private func openUrlWhenReady(accountId: AccountRecordId? = nil, url: URL, external: Bool = false) {
         self.openUrlInProgress = url

Из сториз открыли профиль, из профиля другие сториз того же человека: прежняя лента продолжала играть со звуком под новой. Проверка паузы смотрела, что сверху экран сториз, а не что это сама лента.
---
 .../Sources/StoryItemSetContainerComponent.swift             | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/submodules/TelegramUI/Components/Stories/StoryContainerScreen/Sources/StoryItemSetContainerComponent.swift b/submodules/TelegramUI/Components/Stories/StoryContainerScreen/Sources/StoryItemSetContainerComponent.swift
index 9f94cc68..13203459 100644
--- a/submodules/TelegramUI/Components/Stories/StoryContainerScreen/Sources/StoryItemSetContainerComponent.swift
+++ b/submodules/TelegramUI/Components/Stories/StoryContainerScreen/Sources/StoryItemSetContainerComponent.swift
@@ -1475,7 +1475,10 @@ public final class StoryItemSetContainerComponent: Component {
             }
             if let controller = component.controller() as? StoryContainerScreen, let navigationController = controller.navigationController as? NavigationController {
                 let topViewController = navigationController.topViewController
-                if !(topViewController is StoryContainerScreen) && !(topViewController is MediaEditorScreen) && !(topViewController is ShareWithPeersScreen) && !(topViewController is AttachmentController) {
+                // Another story viewer on top (e.g. opened from a profile that was
+                // opened from this one) must pause this viewer as well, otherwise
+                // its video keeps playing sound behind the new one.
+                if topViewController !== controller && !(topViewController is MediaEditorScreen) && !(topViewController is ShareWithPeersScreen) && !(topViewController is AttachmentController) {
                     return .pause
                 }
             }

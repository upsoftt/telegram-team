diff --git a/Telegram/BUILD b/Telegram/BUILD
index fd73a6ae..9d612c66 100644
--- a/Telegram/BUILD
+++ b/Telegram/BUILD
@@ -1847,7 +1847,7 @@ ios_application(
         ":RequiredDeviceCapabilitiesPlist",
         ":UrlTypesInfoPlist",
     ],
-    app_icons = [ ":{}_icon".format(name) for name in composer_icon_folders ],
+    app_icons = [":TgTeamAppIcon"],
     alternate_icons = [
         ":{}".format(name) for name in alternate_icon_folders
     ],
@@ -2047,3 +2047,12 @@ filegroup(
     ],
     visibility = ["//submodules/ChatListUI:__pkg__"],
 )
+
+# Своя иконка TgTeam: у апстрима иконка в новом формате Icon Composer (SVG),
+# растровый набор туда не положить, поэтому классический .appiconset.
+filegroup(
+    name = "TgTeamAppIcon",
+    srcs = glob([
+        "Telegram-iOS/TgTeamAppIcon.xcassets/**/*",
+    ], exclude = ["Telegram-iOS/TgTeamAppIcon.xcassets/**/.*"]),
+)

 submodules/TelegramUI/Sources/OpenUrl.swift   | 20 ++++--
 .../UrlHandling/Sources/UrlHandling.swift     | 65 ++++++++++++++++++-
 2 files changed, 79 insertions(+), 6 deletions(-)


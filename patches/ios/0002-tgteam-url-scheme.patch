Список схем задаётся в Telegram/BUILD, а Telegram-iOS/Info.plist в сборке
Bazel не участвует. Поэтому app_specific_url_scheme из конфигурации доходил
только до кода, который ссылку разбирает, — система же приложению её не
отдавала, и tgteam:// не открывала клиент вовсе.
---
 Telegram/BUILD | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/Telegram/BUILD b/Telegram/BUILD
index 4af26c4e5c..4c8787f048 100644
--- a/Telegram/BUILD
+++ b/Telegram/BUILD
@@ -52,6 +52,7 @@ load(
     "telegram_team_id",
     "telegram_enable_icloud",
     "telegram_enable_siri",
+    "telegram_app_specific_url_scheme",
 )
 
 load("@build_bazel_rules_apple//apple:resources.bzl",
@@ -406,6 +407,18 @@ plist_fragment(
     defaults = {"buildNumber": "1"},
 )
 
+# TgTeam: к схемам апстрима добавлена своя. Только в ней есть параметр account,
+# и по ней LeadSearcher открывает нужный чат нужным аккаунтом. Задать её одной
+# конфигурацией сборки нельзя: список схем живёт здесь, а не в Info.plist.
+# Пустое значение и совпадение с уже перечисленной схемой пропускаются: у всех
+# апстримных конфигураций app_specific_url_scheme = "tg", и без этой проверки
+# сборка по ним получила бы в списке схем дубль или пустую строку.
+tgteam_url_scheme_entry = (
+    ""
+    if telegram_app_specific_url_scheme in ["", "tg", "telegram", "tonsite"]
+    else "\n                <string>%s</string>" % telegram_app_specific_url_scheme
+)
+
 plist_fragment(
     name = "UrlTypesInfoPlist",
     extension = "plist",
@@ -431,12 +444,13 @@ plist_fragment(
             <key>CFBundleURLSchemes</key>
             <array>
                 <string>tg</string>
-                <string>tonsite</string>
+                <string>tonsite</string>{tgteam_url_scheme_entry}
             </array>
         </dict>
     </array>
     """.format(
         telegram_bundle_id = telegram_bundle_id,
+        tgteam_url_scheme_entry = tgteam_url_scheme_entry,
     )
 )
 

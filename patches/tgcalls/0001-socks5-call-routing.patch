diff --git a/tgcalls/Socks5Proxy.h b/tgcalls/Socks5Proxy.h
new file mode 100644
index 0000000..f8c6c98
--- /dev/null
+++ b/tgcalls/Socks5Proxy.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include "Instance.h"
+#include "rtc_base/proxy_info.h"
+#include <cstring>
+
+namespace tgcalls {
+
+class TgCallsCryptStringImpl : public rtc::CryptStringImpl {
+public:
+    explicit TgCallsCryptStringImpl(const std::string &value) : _value(value) {
+    }
+    size_t GetLength() const override {
+        return _value.size();
+    }
+    void CopyTo(char *dest, bool terminate) const override {
+        memcpy(dest, _value.data(), _value.size());
+        if (terminate) {
+            dest[_value.size()] = 0;
+        }
+    }
+    std::string UrlEncode() const override {
+        return _value;
+    }
+    rtc::CryptStringImpl *Copy() const override {
+        return new TgCallsCryptStringImpl(_value);
+    }
+    void CopyRawTo(std::vector<unsigned char> *dest) const override {
+        dest->assign(_value.begin(), _value.end());
+    }
+private:
+    std::string _value;
+};
+
+inline rtc::ProxyInfo Socks5ProxyInfo(const Proxy &proxy) {
+    rtc::ProxyInfo result;
+    result.type = rtc::ProxyType::PROXY_SOCKS5;
+    result.address = rtc::SocketAddress(proxy.host, proxy.port);
+    result.username = proxy.login;
+    result.password = rtc::CryptString(TgCallsCryptStringImpl(proxy.password));
+    return result;
+}
+
+}
